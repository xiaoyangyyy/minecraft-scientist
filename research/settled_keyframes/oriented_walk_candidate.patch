+    with pytest.raises(ValidationError):
+        stable.StableLongWaitJumpKeyframePolicy.model_validate(current.model_dump())
+    assert (
+        current.model_dump(exclude={"orientation", "maximum_orientation_actions"})
+        == parent.model_dump()
+    )
