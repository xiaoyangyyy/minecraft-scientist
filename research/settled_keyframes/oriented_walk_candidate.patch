+def test_real_static_pixels_do_not_invent_novelty_or_mapping():
+    first, calls = texture(448), []
+
+    def execute(kind, handle):
+        calls.append((kind, handle))
+        return PublicControlStep(first.copy(), kind, handle, True, 1)
+
+    result = stable.acquire_stable_keyframe_map(
+        first,
+        execute,
+        ((100, 0, 224), (0, 100, 224), (0, 0, 1)),
+        anchor_frame=69,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        oriented_controls=True,
+        walking_controls=True,
+    )
+    assert result["terminal"] == "map_unavailable"
+    assert len(result["control_choices"]) == 11
+    assert len(calls) == 8 + 11 * (1 + 8)
+    assert [step["absolute_frame"] for step in result["steps"]] == list(range(70, 177))
+    assert result["movement_program_registration"] == "opaque-four-cardinal-walk-v1"
+    assert result["walking_control_registration"] == "opaque-four-cardinal-walk-v1"
+    assert result["frozen"] is None and result["future"] is None
+    assert not result["navigation_accepted"]
