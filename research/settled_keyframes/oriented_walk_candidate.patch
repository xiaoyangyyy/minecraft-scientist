+@pytest.mark.parametrize("walking", [False, True])
+def test_wrapper_preserves_actual_orientation_and_future_tick_costs(
+    monkeypatch, walking
+):
+    first = texture(448)
+    monkeypatch.setattr(orientation, "rank_views", lambda *args: {"selected_frame": 33})
+    calls = []
+
+    def execute(kind):
+        calls.append(kind)
+        return orientation.SurveyReceipt(first.copy(), kind, kind == "look", True, 1)
+
+    def acquire(frame, controller, camera, **kwargs):
+        assert kwargs["anchor_frame"] == 69 and kwargs["walking_controls"] is walking
+        assert kwargs["oriented_controls"] and kwargs["long_wait_controls"]
+        policy = kwargs["policy"]
+        expected = (
+            stable.StableOrientedWalkKeyframePolicy
+            if walking
+            else stable.StableOrientedJumpKeyframePolicy
+        )
+        assert type(policy) is expected
+        assert policy.move_ticks == 1 and policy.validation_move_ticks == 2
+        assert policy.maximum_episode_actions == 288
+        return {"test_only": True}
+
+    monkeypatch.setattr(stable, "acquire_stable_keyframe_map", acquire)
+    result = orientation.run_oriented_keyframe_map(
+        [first] * 12, execute, forbidden, np.eye(3), walking_controls=walking
+    )
+    assert calls == ["look", "wait", "wait"] * 7
+    assert result["orientation"]["end_frame"] == 69
