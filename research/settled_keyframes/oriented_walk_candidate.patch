+def acquire(first, execute, *, anchor=81, **kwargs):
+    return stable.acquire_stable_keyframe_map(
+        first,
+        execute,
+        ((100, 0, 224), (0, 100, 224), (0, 0, 1)),
+        anchor_frame=anchor,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        oriented_controls=True,
+        **kwargs,
+    )
+
