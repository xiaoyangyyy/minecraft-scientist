+@pytest.mark.parametrize("flag", [True, 1, "true"])
+def test_risk_registration_requires_exact_flags_and_all_walking_parents(flag):
+    called = []
+    with pytest.raises(ValueError):
+        stable.acquire_stable_keyframe_map(
+            np.zeros((224, 224, 3), dtype=np.uint8),
+            lambda *args: called.append(args),
+            np.eye(3),
+            anchor_frame=48,
+            risk_controls=flag,
+        )
+    assert called == []
+
+
+def test_monitored_policy_cannot_masquerade_as_historical_walking():
+    values = stable.StableMonitoredWalkKeyframePolicy().model_dump()
+    with pytest.raises(ValidationError):
+        stable.StableOrientedWalkKeyframePolicy.model_validate(values)
+    with pytest.raises(ValidationError):
+        stable.StableMonitoredWalkKeyframePolicy.model_validate(
+            values | {"maximum_episode_actions": 300}
+        )
+
