+import numpy as np
+import pytest
+from pydantic import ValidationError
+from test_public_view_quality import texture
+
+pytest.importorskip("cv2")
+
+from minecraft_scientist.exploration import public_view_orientation as orientation
+from minecraft_scientist.exploration import stable_keyframe_map as stable
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+
+
+def forbidden(*args, **kwargs):
+    raise AssertionError("invalid or abstained protocol dispatched a control")
+
+
+@pytest.mark.parametrize("selected,anchor", [(15, 51), (33, 69), (45, 81), (48, 48)])
+def test_orientation_hands_actual_endpoint_and_clock_to_unchanged_acquisition(
+    monkeypatch, selected, anchor
+):
+    first = texture(448)
+    references = [first.copy() for _ in range(12)]
+    returned = first.copy()
+    returned[100, 100] = 0
+    monkeypatch.setattr(
+        orientation, "rank_views", lambda *args: {"selected_frame": selected}
+    )
+    calls = []
+
+    def execute(kind):
+        calls.append(kind)
+        return orientation.SurveyReceipt(returned.copy(), kind, kind == "look", True, 1)
+
+    def acquire(frame, controller, camera, **kwargs):
+        assert kwargs["anchor_frame"] == anchor
+        assert all(
+            kwargs[name] is True
+            for name in (
+                "micro_controls",
+                "responsive_controls",
+                "recovery_controls",
+                "safe_seed_controls",
+                "jump_controls",
+                "long_wait_controls",
+                "oriented_controls",
+            )
+        )
+        assert controller is forbidden
+        assert np.array_equal(frame, returned if anchor != 48 else first)
+        assert kwargs["policy"] == stable.StableOrientedJumpKeyframePolicy()
+        return {"test_only": True, "anchor_frame": anchor}
+
+    monkeypatch.setattr(stable, "acquire_stable_keyframe_map", acquire)
+    result = orientation.run_oriented_keyframe_map(
+        references, execute, forbidden, np.eye(3)
+    )
+    assert len(calls) == anchor - 48
+    assert result["acquisition"]["anchor_frame"] == anchor
+    assert all(np.array_equal(image, first) for image in references)
+
+
+@pytest.mark.parametrize("selected,failed", [(None, False), (15, True)])
+def test_no_view_or_failed_orientation_never_starts_acquisition(
+    monkeypatch, selected, failed
+):
+    first = np.zeros((448, 448, 3), np.uint8)
+    monkeypatch.setattr(
+        orientation, "rank_views", lambda *args: {"selected_frame": selected}
+    )
+    monkeypatch.setattr(stable, "acquire_stable_keyframe_map", forbidden)
+
+    def execute(kind):
+        assert failed
+        return orientation.SurveyReceipt(first, kind, kind == "look", False, 1)
+
+    result = orientation.run_oriented_keyframe_map(
+        [first] * 12, execute, forbidden, np.eye(3)
+    )
+    assert result["acquisition"] is None
+    assert result["orientation"]["terminal"] == (
+        "execution_failed" if failed else "no_eligible_view"
+    )
+    assert result["orientation"]["end_frame"] == (49 if failed else 48)
+
+
+@pytest.mark.parametrize("policy", [False, 0, "default", []])
+def test_untyped_policy_rejected_before_any_dispatch(policy):
+    with pytest.raises(TypeError):
+        orientation.run_oriented_keyframe_map(
+            [], forbidden, forbidden, np.eye(3), policy=policy
+        )
+
+
+@pytest.mark.parametrize("seed", [True, 1.0, -1, 2**31])
+def test_untyped_or_unbounded_seed_rejected_before_any_dispatch(seed):
+    with pytest.raises(ValueError, match="exact seed"):
+        orientation.run_oriented_keyframe_map(
+            [], forbidden, forbidden, np.eye(3), seed=seed
+        )
+
+
+@pytest.mark.parametrize("budget", [32, 34, 33.0, True])
+def test_orientation_policy_is_frozen_exact_and_cannot_disguise_as_parent(budget):
+    with pytest.raises(ValidationError):
+        stable.StableOrientedJumpKeyframePolicy(maximum_orientation_actions=budget)
+    current, parent = (
+        stable.StableOrientedJumpKeyframePolicy(),
+        stable.StableLongWaitJumpKeyframePolicy(),
+    )
+    with pytest.raises(ValidationError):
+        stable.StableLongWaitJumpKeyframePolicy.model_validate(current.model_dump())
+    assert (
+        current.model_dump(exclude={"orientation", "maximum_orientation_actions"})
+        == parent.model_dump()
+    )
+
+
+def acquire(first, execute, *, anchor=81, **kwargs):
+    return stable.acquire_stable_keyframe_map(
+        first,
+        execute,
+        ((100, 0, 224), (0, 100, 224), (0, 0, 1)),
+        anchor_frame=anchor,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        oriented_controls=True,
+        **kwargs,
+    )
+
+
+@pytest.mark.parametrize("anchor", [47, 82, 81.0, True])
+def test_oriented_anchor_is_actual_bounded_not_a_virtual_reset(anchor):
+    with pytest.raises(ValueError, match="actual anchor"):
+        acquire(texture(448), forbidden, anchor=anchor)
+
+
+@pytest.mark.parametrize("walking", [False, True])
+def test_longest_orientation_prefix_consumes_original_global_288_budget(
+    monkeypatch, walking
+):
+    first, calls = texture(448), []
+    moved, waits = False, 0
+
+    def execute(kind, handle):
+        nonlocal moved, waits
+        calls.append((kind, handle))
+        if kind == "move":
+            moved, waits = True, 0
+        elif moved:
+            waits += 1
+        return PublicControlStep(first.copy(), kind, handle, True, 1)
+
+    original = stable._visible_flow
+
+    def flow(*args, **kwargs):
+        observed = original(*args, **kwargs)
+        if moved:
+            observed["stable"] = waits >= 22
+        return observed
+
+    monkeypatch.setattr(stable, "_visible_flow", flow)
+    result = acquire(first, execute, walking_controls=walking)
+    assert result["terminal"] == "budget_exhausted"
+    assert len(calls) == 288 - 81
+    assert [step["absolute_frame"] for step in result["steps"]] == list(range(82, 289))
+    assert not result["navigation_accepted"] and result["frozen"] is None
+    assert (
+        result["orientation_registration"]
+        == "twelve-view-public-survey-counted-look-v1"
+    )
+
+
+@pytest.mark.parametrize("flag", [1, None, "true"])
+def test_oriented_flag_requires_exact_boolean(flag):
+    with pytest.raises(ValueError, match="explicit boolean"):
+        stable.acquire_stable_keyframe_map(
+            texture(448), forbidden, np.eye(3), anchor_frame=48, oriented_controls=flag
+        )
+
+
+def test_oriented_flag_requires_parent_chain():
+    with pytest.raises(ValueError, match="explicit long-wait"):
+        stable.acquire_stable_keyframe_map(
+            texture(448), forbidden, np.eye(3), anchor_frame=48, oriented_controls=True
+        )
