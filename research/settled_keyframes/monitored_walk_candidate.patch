+"""Actual controller/monitor dispatch, with explicit past-model/flow doubles.
+
+Real RGB tracking and receipt chronology are exercised. These tests do not prove
+geometric correctness, native map recovery, player rest, navigation or arrival.
+"""
+
+import copy
+import hashlib
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+from pydantic import ValidationError
+from test_public_map_risk import fixture as fixture  # noqa: PLC0414
+
+from minecraft_scientist.exploration import public_map_risk as risk
+from minecraft_scientist.exploration import public_view_orientation as orientation
+from minecraft_scientist.exploration import stable_keyframe_map as stable
+from minecraft_scientist.exploration.joint_multiview_map import JointPose
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+
+FLAGS = {
+    "micro_controls": True,
+    "responsive_controls": True,
+    "recovery_controls": True,
+    "safe_seed_controls": True,
+    "jump_controls": True,
+    "long_wait_controls": True,
+    "oriented_controls": True,
+    "walking_controls": True,
+    "risk_controls": True,
+}
+
+
+@pytest.fixture
+def scene(fixture, monkeypatch):
+    _, frames, _ = fixture
+    first = frames[0].copy()
+    first[0, 0, 0] = 0
+    calls, fitted = [], []
+
+    def execute(kind, handle):
+        calls.append((kind, handle))
+        image = first.copy()
+        image[0, 0, 0] = len(calls)
+        return PublicControlStep(image, kind, handle, True, 1)
+
+    def flow(first, last, settings, *, seed_pixels):
+        novelty = int(last[0, 0, 0]) - int(first[0, 0, 0]) > 1
+        return {
+            "tracks": {
+                "track_ids": list(range(len(seed_pixels))),
+                "seed_count": len(seed_pixels),
+            },
+            "cells": 4,
+            "stable": not novelty,
+            "median_flow_pixels": 4 if novelty else 0,
+            "percentile95_flow_pixels": 5 if novelty else 0,
+        }
+
+    def fit(tracks, camera, *, bootstrap_slot, seed, config):
+        fitted.append(len(calls))
+        values = {
+            "bootstrap_slot": bootstrap_slot,
+            "supported": bootstrap_slot != 2,
+            "input_sha256": hashlib.sha256(
+                tracks.model_dump_json().encode()
+            ).hexdigest(),
+            "fitting_frames": tracks.frame_count,
+            "config": config.model_dump(mode="json"),
+        }
+        return SimpleNamespace(
+            **values,
+            poses=tuple(
+                JointPose(
+                    frame_slot=slot,
+                    rotation=np.eye(3).tolist(),
+                    translation=[-slot, 0, 0],
+                )
+                for slot in range(tracks.frame_count)
+            ),
+            model_dump=lambda **kwargs: copy.deepcopy(values),
+        )
+
+    monkeypatch.setattr(stable, "_visible_flow", flow)
+    monkeypatch.setattr(risk, "_visible_flow", flow)
+    monkeypatch.setattr(stable, "fit_joint_map", fit)
+    return first, execute, calls, fitted
+
+
+def run(scene, *, execute=None):
+    first, dispatch, _, _ = scene
+    return stable.acquire_stable_keyframe_map(
+        first, execute or dispatch, np.eye(3), anchor_frame=51, **FLAGS
+    )
+
+
+@pytest.mark.parametrize("at", [1, 2, 5])
+def test_first_risky_actual_move_or_wait_stops_old_map_then_passive_waits(
+    scene, monkeypatch, at
+):
+    checks = []
+
+    def validate(model, past, extended, *, target_slots):
+        tick = extended.frame_count - past.frame_count
+        checks.append((tick, model.bootstrap_slot))
+        return {
+            "status": "inconsistent"
+            if tick == at and model.bootstrap_slot == 3
+            else "consistent"
+            if model.supported
+            else "unavailable",
+            "navigation_accepted": False,
+        }
+
+    monkeypatch.setattr(risk, "validate_joint_future", validate)
+    result = run(scene)
+    _, _, calls, fitted = scene
+    frozen_at = result["frozen"]["frozen_at_frame"]
+    risk_journal = result["map_risk"]
+    recovery = result["map_risk_recovery"]
+    assert result["terminal"] == "map_risk_reacquisition_ready"
+    assert risk_journal["terminal"] == "challenged"
+    assert len(risk_journal["records"]) == at
+    assert checks == [
+        (tick, slot) for tick in range(1, at + 1) for slot in (2, 3, 4, 5)
+    ]
+    assert len(recovery["steps"]) == 8
+    assert recovery["anchor_frame"] == frozen_at + at
+    assert recovery["new_epoch"]["anchor_frame"] == frozen_at + at + 8
+    assert calls[frozen_at - 51 + at :] == [("wait", None)] * 8
+    assert len(calls) == len(result["steps"])
+    assert [step["absolute_frame"] for step in result["steps"]] == list(
+        range(52, 52 + len(calls))
+    )
+    assert fitted == [frozen_at - 51] * 4  # never refit during recovery
+    assert result["future"] is None and result["motion"] is None
+    assert not recovery["old_map_restored"] and not recovery["gauge_connection_known"]
+    assert not recovery["body_rest_known"] and not result["navigation_accepted"]
+    assert stable._digest(result["frozen"]) == result["frozen_sha256"]
+
+
+def test_bad_future_control_cannot_trigger_scientific_recovery(scene):
+    _, dispatch, _, fitted = scene
+
+    def bad(kind, handle):
+        receipt = dispatch(kind, handle)
+        if fitted:
+            return PublicControlStep(receipt.frame, kind, handle, False, 1)
+        return receipt
+
+    result = run(scene, execute=bad)
+    assert result["terminal"] == "execution_failed"
+    assert result["map_risk"]["terminal"] == "control_failed"
+    assert not result["map_risk"]["records"][-1]["theory_counterexample"]
+    assert result["map_risk_recovery"] is None
+    assert result["steps"][-1]["compliant"] is False
+
+
+@pytest.mark.parametrize("final_status", ["consistent", "inconsistent"])
+def test_all_raw_actions_are_checked_but_cannot_replace_final_motion_gate(
+    scene, monkeypatch, final_status
+):
+    def final(model, past, extended, *, target_slots):
+        return {
+            "status": final_status if model.supported else "unavailable",
+            "poses": [
+                {
+                    "frame_slot": extended.frame_count - 1,
+                    "rotation": np.eye(3).tolist(),
+                    "translation": [-10, 0, 0],
+                }
+            ],
+        }
+
+    monkeypatch.setattr(stable, "validate_joint_future", final)
+    result = run(scene)
+    assert result["map_risk"]["terminal"] == "observable"
+    assert len(result["map_risk"]["records"]) == 10  # two MOVE + eight WAIT
+    assert result["map_risk_recovery"] is None
+    assert result["terminal"] == (
+        "validated" if final_status == "consistent" else "rejected"
+    )
+    assert (result["motion"] is not None) is (final_status == "consistent")
+    assert not result["map_risk"]["motion_validated"]
+    assert not result["navigation_accepted"]
+
+
+def test_recovery_exception_preserves_unknown_consumption_without_invented_tick(
+    scene, monkeypatch
+):
+    _, dispatch, calls, fitted = scene
+    monkeypatch.setattr(
+        risk,
+        "validate_joint_future",
+        lambda *args, **kwargs: {
+            "status": "inconsistent",
+            "navigation_accepted": False,
+        },
+    )
+
+    def throwing(kind, handle):
+        if fitted and kind == "wait":
+            raise OSError("injected unknown WAIT consumption")
+        return dispatch(kind, handle)
+
+    result = run(scene, execute=throwing)
+    assert result["terminal"] == "map_risk_execution_failed"
+    assert result["map_risk_recovery"]["steps"][-1]["actual_frame_known"] is False
+    assert len(result["steps"]) == len(calls)
+    assert result["map_risk_recovery"]["new_epoch"] is None
+
