+    with pytest.raises(ValidationError):
+        stable.StableOrientedWalkKeyframePolicy.model_validate(parent.model_dump())
+
+
+@pytest.mark.parametrize("flag", [1, None, "true"])
+def test_walking_flag_requires_exact_boolean_before_dispatch(flag):
+    with pytest.raises(ValueError, match="explicit boolean"):
+        orientation.run_oriented_keyframe_map(
+            [], forbidden, forbidden, np.eye(3), walking_controls=flag
+        )
+    with pytest.raises(ValueError, match="explicit boolean"):
