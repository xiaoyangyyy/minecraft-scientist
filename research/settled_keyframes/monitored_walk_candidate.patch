+    )
+    rgb = np.repeat(gray[:, :, None], 3, axis=2)
+    frames = [rgb.copy() for _ in range(6)]
+    seeds = safe_seeds(frames[0])
+    tracks = track_frame_chain(
+        frames, config=TemporalTrackConfig(maximum_frames=128), seed_pixels=seeds
+    )
+    ordinal = [56, 65, 74, 83, 92, 101]
+    frozen = {
+        "index": {
+            "namespace": "unit-dispatch-only",
+            "frame_ordinals": ordinal,
+            "rgb_sha256": [risk._rgb_hash(frame) for frame in frames],
+            "tracks": tracks.model_dump(mode="json"),
+            "continuous_raw_identity": False,
+        },
+        "past": tracks.model_dump(mode="json"),
+        "frozen_at_frame": 101,
+        "detector": {
+            "registration": "first-image-only-safe-support-mask-v1",
+            "seed_image_frame": 56,
+            "seed_image_sha256": risk._rgb_hash(frames[0]),
+            "seed_pixels": seeds.tolist(),
+        },
+        "maps": [
+            {
+                "bootstrap_slot": slot,
+                "supported": slot != 2,
+                "input_sha256": hashlib.sha256(
+                    tracks.model_dump_json().encode()
+                ).hexdigest(),
+                "fitting_frames": 6,
+                "config": JointMapConfig(),
+            }
+            for slot in (2, 3, 4, 5)
+        ],
+        "required_bootstraps": [3, 4, 5],
+    }
+    # _digest requires JSON values; parser double reconstitutes the config.
+    for model in frozen["maps"]:
+        model["config"] = model["config"].model_dump(mode="json")
+    monkeypatch.setattr(
+        risk.JointMapEvidence,
+        "model_validate",
+        lambda item: SimpleNamespace(
+            **(item | {"config": JointMapConfig.model_validate(item["config"])})
+        ),
+    )
+    calls = []
+
+    def validate(model, past, extended, *, target_slots):
+        calls.append((model.bootstrap_slot, extended.frame_count, target_slots))
+        return {
+            "status": "consistent" if model.supported else "unavailable",
+            "navigation_accepted": False,
+        }
+
+    monkeypatch.setattr(risk, "validate_joint_future", validate)
+    return frozen, frames, calls
