+def test_orientation_wrapper_forwards_explicit_monitored_policy(monkeypatch):
+    first = np.zeros((224, 224, 3), dtype=np.uint8)
+    monkeypatch.setattr(
+        orientation,
+        "orient",
+        lambda *args: orientation.OrientationOutcome(
+            {"terminal": "completed", "end_frame": 77}, first
+        ),
+    )
+    forwarded = []
+    monkeypatch.setattr(
+        stable,
+        "acquire_stable_keyframe_map",
+        lambda *args, **kwargs: forwarded.append(kwargs) or {"terminal": "unit-only"},
+    )
+    result = orientation.run_oriented_keyframe_map(
+        [first] * 12,
+        lambda *args: None,
+        lambda *args: None,
+        np.eye(3),
+        walking_controls=True,
+        risk_controls=True,
+    )
+    assert result["acquisition"]["terminal"] == "unit-only"
+    assert forwarded[0]["anchor_frame"] == 77
+    assert forwarded[0]["risk_controls"] is True
+    assert isinstance(forwarded[0]["policy"], stable.StableMonitoredWalkKeyframePolicy)
