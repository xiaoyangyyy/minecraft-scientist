new file mode 100644
--- /dev/null
+++ b/src/minecraft_scientist/exploration/public_map_risk.py
@@ -0,0 +1,447 @@
+"""Per-action frozen-map observability, followed by explicit passive recovery.
+
+Public pixels/control receipts only. Pixel consistency is not body accuracy or
+safety. Challenged maps never recover by reseeding, refitting, endpoint selection
+or replacing their original partitions; recovery prepares an unconnected epoch.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+from dataclasses import dataclass
+from typing import Literal
+
+import numpy as np
+from pydantic import BaseModel, ConfigDict, model_validator
+
+from .causal_map_window import CausalWindowPolicy
+from .joint_multiview_map import JointMapConfig, JointMapEvidence, validate_joint_future
+from .map_recovery import _digest
+from .public_wait_profile import PostMotorWaitWindow
+from .safe_track_seeds import safe_seeds
+from .second_leg_shadow import retain_tracks
+from .settled_map_control import PublicControlStep
+from .shared_map_endpoint import SharedEndpointPolicy, _visible_flow
+from .temporal_tracks import TemporalTrackConfig, track_frame_chain
+from .visual_geometry import _frame
+
+
+class MapRiskPolicy(BaseModel):
+    model_config = ConfigDict(extra="forbid", frozen=True)
+    registration: Literal["continuous-original-map-observability-v1"] = (
+        "continuous-original-map-observability-v1"
+    )
+    maximum_episode_actions: Literal[288] = 288
+    maximum_future_steps: Literal[80] = 80
+    maximum_passive_windows: Literal[2] = 2
+    temporal: TemporalTrackConfig = TemporalTrackConfig(maximum_frames=128)
+    consensus: CausalWindowPolicy = CausalWindowPolicy()
+    passive: PostMotorWaitWindow = PostMotorWaitWindow()
+    stability: SharedEndpointPolicy = SharedEndpointPolicy()
+
+    @model_validator(mode="before")
+    @classmethod
+    def _strict_budgets(cls, values):
+        if isinstance(values, dict) and any(
+            type(values.get(name, default)) is not int
+            for name, default in (
+                ("maximum_episode_actions", 288),
+                ("maximum_future_steps", 80),
+                ("maximum_passive_windows", 2),
+            )
+        ):
+            raise ValueError("map-risk budgets must be exact integers")
+        return values
+
+    @model_validator(mode="after")
+    def _registered_gates(self):
+        if (
+            self.temporal != TemporalTrackConfig(maximum_frames=128)
+            or self.consensus != CausalWindowPolicy()
+            or self.passive != PostMotorWaitWindow()
+            or self.stability != SharedEndpointPolicy()
+        ):
+            raise ValueError("map-risk monitoring cannot relax tracking/settling gates")
+        return self
+
+
+@dataclass(frozen=True)
+class RecoveryObservation:
+    journal: dict
+    frame: np.ndarray | None
+
+
+def _rgb_hash(frame):
+    return hashlib.sha256(frame.tobytes()).hexdigest()
+
+
+def _checked_receipt(receipt, kind, handle, shape):
+    if (
+        not isinstance(receipt, PublicControlStep)
+        or type(receipt.executed_kind) is not str
+        or type(receipt.compliant) is not bool
+        or receipt.compliant is not True
+        or type(receipt.ticks) is not int
+        or receipt.ticks != 1
+        or receipt.executed_kind != kind
+        or receipt.executed_handle != handle
+        or (kind == "wait" and receipt.executed_handle is not None)
+        or (kind == "move" and type(receipt.executed_handle) is not int)
+    ):
+        raise ValueError("requires an exact compliant one-tick public receipt")
+    frame = _frame(receipt.frame).copy()
+    if frame.shape != shape:
+        raise ValueError("map-risk control changed the public sensor")
+    frame.setflags(write=False)
+    return frame
+
+
+class FrozenMapMonitor:
+    """No actions are dispatched here. A failure irreversibly seals this epoch."""
+
+    def __init__(self, frozen, frames, *, policy=None):
+        # Lazy schema import permits the acquisition controller to use this
+        # monitor without a circular module-initialization dependency.
+        from .stable_keyframe_map import KeyframeIndex
+
+        self.policy = MapRiskPolicy.model_validate(
+            policy.model_dump() if isinstance(policy, MapRiskPolicy) else policy or {}
+        )
+        # Refuse extra/private context before cloning or serializing the parent.
+        if type(frozen) is not dict or set(frozen) != {
+            "index",
+            "past",
+            "frozen_at_frame",
+            "detector",
+            "maps",
+            "required_bootstraps",
+        }:
+            raise ValueError("map monitor accepts only the registered public proposal")
+        if type(frozen["detector"]) is not dict or set(frozen["detector"]) != {
+            "registration",
+            "seed_image_frame",
+            "seed_image_sha256",
+            "seed_pixels",
+        }:
+            raise ValueError("map detector cannot include extra/private context")
+        self._parent = frozen
+        self._parent_sha = _digest(frozen)
+        self._frozen = copy.deepcopy(frozen)
+        self._index = KeyframeIndex.model_validate(frozen["index"])
+        self._past = self._index.tracks
+        if (
+            type(frozen["frozen_at_frame"]) is not int
+            or frozen["past"] != self._past.model_dump(mode="json")
+            or frozen["frozen_at_frame"] != self._index.frame_ordinals[-1]
+            or not 6 <= self._past.frame_count <= 12
+            or not 0 <= frozen["frozen_at_frame"] <= 288
+        ):
+            raise ValueError("monitor requires the exact complete frozen past")
+        self._images = tuple(_frame(frame).copy() for frame in frames)
+        if (
+            len(self._images) != self._past.frame_count
+            or any(frame.shape != self._images[0].shape for frame in self._images)
+            or tuple(_rgb_hash(frame) for frame in self._images)
+            != self._index.rgb_sha256
+        ):
+            raise ValueError("monitor images differ from frozen image clock/hashes")
+        for frame in self._images:
+            frame.setflags(write=False)
+        detector = frozen["detector"]
+        self._seeds = safe_seeds(self._images[0]).copy()
+        self._seeds.setflags(write=False)
+        if (
+            detector["registration"] != "first-image-only-safe-support-mask-v1"
+            or type(detector["seed_image_frame"]) is not int
+            or detector["seed_image_frame"] != self._index.frame_ordinals[0]
+            or detector["seed_image_sha256"] != self._index.rgb_sha256[0]
+            or detector["seed_pixels"] != self._seeds.tolist()
+        ):
+            raise ValueError("monitor cannot replace original detector seeds")
+        replayed = track_frame_chain(
+            self._images, config=self.policy.temporal, seed_pixels=self._seeds
+        )
+        if replayed != self._past:
+            raise ValueError("monitor tracking does not replay original frozen pixels")
+        self._models = tuple(
+            JointMapEvidence.model_validate(item) for item in frozen["maps"]
+        )
+        self._required = tuple(frozen["required_bootstraps"])
+        if (
+            tuple(model.bootstrap_slot for model in self._models)
+            != tuple(range(2, self._past.frame_count))
+            or self._required
+            != tuple(model.bootstrap_slot for model in self._models if model.supported)
+            or len(self._required) < self.policy.consensus.minimum_models
+            or any(
+                model.input_sha256
+                != hashlib.sha256(self._past.model_dump_json().encode()).hexdigest()
+                or model.fitting_frames != self._past.frame_count
+                or model.config != JointMapConfig()
+                for model in self._models
+            )
+        ):
+            raise ValueError("monitor cannot select other models/partitions/gates")
+        self._future = []
+        self._retained = set(self._past.track_ids)
+        self._state = "observable"
+        self._records = []
+        self._recovery_started = False
+        self._ordinal = frozen["frozen_at_frame"]
+        self._latest = self._images[-1]
+        self._integrity()
+
+    def _integrity(self):
+        if (
+            _digest(self._parent) != self._parent_sha
+            or _digest(self._frozen) != self._parent_sha
+        ):
+            raise ValueError("the original frozen map was changed")
+
+    @property
+    def state(self):
+        return self._state
+
+    @property
+    def journal(self):
+        self._integrity()
+        return {
+            "policy": self.policy.model_dump(mode="json"),
+            "parent_sha256": self._parent_sha,
+            "records": copy.deepcopy(self._records),
+            "terminal": self._state,
+            "latent_cause": "unidentified",
+            "body_rest_known": False,
+            "motion_validated": False,
+            "navigation_accepted": False,
+        }
+
+    def preflight(self, kind, handle):
+        self._integrity()
+        if (
+            kind not in ("move", "wait")
+            or (kind == "move" and (type(handle) is not int or not 0 <= handle < 4))
+            or (kind == "wait" and handle is not None)
+        ):
+            raise ValueError("requires a registered anonymous MOVE or WAIT")
+        if self._state != "observable":
+            return False
+        if (
+            self._ordinal >= 288
+            or len(self._future) >= self.policy.maximum_future_steps
+        ):
+            self._state = "budget_exhausted"
+            return False
+        return True
+
+    def observe(self, receipt, *, kind, handle, absolute_frame):
+        if not self.preflight(kind, handle):
+            raise ValueError("closed/risky epoch cannot consume more map evidence")
+        if type(absolute_frame) is not int or absolute_frame != self._ordinal + 1:
+            raise ValueError("map monitor requires the next exact actual image ordinal")
+        record = {
+            "absolute_frame": absolute_frame,
+            "requested_kind": kind,
+            "requested_handle": handle,
+            "compliant": False,
+            "executed_kind": getattr(receipt, "executed_kind", None),
+            "executed_handle": getattr(receipt, "executed_handle", None),
+            "ticks": getattr(receipt, "ticks", None),
+            "receipt_compliance": getattr(receipt, "compliant", None),
+            "candidates": [],
+            "original_seed_count": len(self._seeds),
+            "retained_past_ids": [],
+            "theory_counterexample": False,
+            "counterexample_scope": "frozen-map-public-pixel-prediction-only",
+            "latent_cause": "unidentified",
+            "motion_validated": False,
+            "navigation_accepted": False,
+        }
+        self._records.append(record)
+        self._ordinal = absolute_frame
+        try:
+            current = _checked_receipt(receipt, kind, handle, self._images[0].shape)
+        except (TypeError, ValueError) as error:
+            record.update(
+                status="control_failed",
+                failure={"type": type(error).__name__, "message": str(error)},
+            )
+            self._state = "control_failed"
+            return copy.deepcopy(record)
+        record.update(compliant=True, rgb_sha256=_rgb_hash(current))
+        self._latest = current
+        self._future.append(current)
+        try:
+            tracked = track_frame_chain(
+                self._images + tuple(self._future),
+                config=self.policy.temporal,
+                seed_pixels=self._seeds,
+            )
+            if tracked.seed_count != len(self._seeds):
+                raise ValueError("future tracking changed original seed denominator")
+            self._retained &= set(tracked.track_ids)
+            extended = retain_tracks(tracked, self._retained)
+            record["retained_past_ids"] = list(extended.track_ids)
+            for model in self._models:
+                result = validate_joint_future(
+                    model,
+                    self._past,
+                    extended,
+                    target_slots=(extended.frame_count - 1,),
+                )
+                record["candidates"].append(
+                    {
+                        "bootstrap_slot": model.bootstrap_slot,
+                        "required": model.bootstrap_slot in self._required,
+                        "future": result,
+                    }
+                )
+            statuses = [
+                item["future"]["status"]
+                for item in record["candidates"]
+                if item["required"]
+            ]
+            if any(
+                status not in ("consistent", "inconsistent", "unavailable")
+                for status in statuses
+            ):
+                raise ValueError("unregistered frozen-model prediction status")
+            self._state = (
+                "challenged"
+                if "inconsistent" in statuses
+                else "support_lost"
+                if "unavailable" in statuses
+                else "observable"
+            )
+            record.update(
+                status=self._state, theory_counterexample=self._state == "challenged"
+            )
+        except Exception as error:  # noqa: BLE001 -- solver failure is not a scientific counterexample
+            record.update(
+                status="geometry_failed",
+                failure={"type": type(error).__name__, "message": str(error)},
+            )
+            self._state = "geometry_failed"
+        self._integrity()
+        return copy.deepcopy(record)
+
+    def recover_observation(self, execute):
+        """WAIT only, up to two registered 24-tick windows/global clock 288.
+
+        A stable new observation permits separate acquisition, not reinstatement
+        of the challenged parent, inferred ground contact or aligned map gauges.
+        """
+        self._integrity()
+        if (
+            self._state not in ("challenged", "support_lost", "geometry_failed")
+            or self._recovery_started
+        ):
+            raise ValueError("recovery requires one new publicly failed map epoch")
+        self._recovery_started = True
+        journal = {
+            "registration": "bounded-passive-map-risk-recovery-v1",
+            "parent_sha256": self._parent_sha,
+            "source_failure_sha256": _digest(self._records[-1]),
+            "anchor_frame": self._ordinal,
+            "steps": [],
+            "windows": [],
+            "terminal": "recovering",
+            "new_epoch": None,
+            "old_map_restored": False,
+            "gauge_connection_known": False,
+            "body_rest_known": False,
+            "motion_validated": False,
+            "navigation_accepted": False,
+        }
+        current, streak = self._latest, 0
+        for number in range(self.policy.maximum_passive_windows):
+            window = {
+                "number": number,
+                "start_frame": self._ordinal,
+                "end_frame": self._ordinal,
+                "status": "running",
+            }
+            journal["windows"].append(window)
+            for tick in range(1, self.policy.passive.maximum_wait_ticks + 1):
+                self._integrity()
+                if self._ordinal >= 288:
+                    journal["terminal"] = window["status"] = "budget_exhausted"
+                    return RecoveryObservation(journal, None)
+                entry = {
+                    "absolute_frame": self._ordinal + 1,
+                    "requested_kind": "wait",
+                    "requested_handle": None,
+                    "compliant": False,
+                }
+                journal["steps"].append(entry)
+                try:
+                    receipt = execute("wait", None)
+                except Exception as error:  # noqa: BLE001 -- unknown control consumption stays explicit
+                    entry.update(
+                        failure={"type": type(error).__name__, "message": str(error)},
+                        actual_frame_known=False,
+                    )
+                    journal["terminal"] = window["status"] = "execution_failed"
+                    return RecoveryObservation(journal, None)
+                self._ordinal += 1
+                window["end_frame"] = self._ordinal
+                entry.update(
+                    executed_kind=getattr(receipt, "executed_kind", None),
+                    executed_handle=getattr(receipt, "executed_handle", None),
+                    ticks=getattr(receipt, "ticks", None),
+                    receipt_compliance=getattr(receipt, "compliant", None),
+                )
+                try:
+                    image = _checked_receipt(receipt, "wait", None, current.shape)
+                    entry.update(compliant=True, rgb_sha256=_rgb_hash(image))
+                except (TypeError, ValueError) as error:
+                    entry.update(
+                        failure={"type": type(error).__name__, "message": str(error)}
+                    )
+                    journal["terminal"] = window["status"] = "control_failed"
+                    return RecoveryObservation(journal, None)
+                try:
+                    seeds = safe_seeds(current)
+                    flow = _visible_flow(
+                        current, image, self.policy.stability, seed_pixels=seeds
+                    )
+                    entry["flow"] = flow
+                    entry.update(
+                        namespace=f"risk-recovery-pair-{self._ordinal}",
+                        seed_detection_registration="first-image-only-safe-support-mask-v1",
+                        seed_image_sha256=_rgb_hash(current),
+                    )
+                    if type(flow.get("stable")) is not bool or flow["tracks"][
+                        "seed_count"
+                    ] != len(seeds):
+                        raise ValueError("invalid independently seeded recovery flow")
+                except Exception as error:  # noqa: BLE001 -- never mistake solver failure for stabilization
+                    journal["terminal"] = window["status"] = "geometry_failed"
+                    entry["failure"] = {
+                        "type": type(error).__name__,
+                        "message": str(error),
+                    }
+                    return RecoveryObservation(journal, None)
+                current = image
+                streak = streak + 1 if flow["stable"] else 0
+                if (
+                    tick >= self.policy.passive.minimum_wait_ticks
+                    and streak >= self.policy.passive.stable_prefixes
+                ):
+                    journal["terminal"] = window["status"] = "reacquisition_ready"
+                    journal["new_epoch"] = {
+                        "namespace": f"unconnected-risk-recovery-{self._ordinal}",
+                        "anchor_frame": self._ordinal,
+                        "rgb_sha256": _rgb_hash(current),
+                        "parent_sha256": self._parent_sha,
+                        "connection_supported": False,
+                    }
+                    self._integrity()
+                    ready = current.copy()
+                    ready.setflags(write=False)
+                    return RecoveryObservation(journal, ready)
+            window["status"] = "exhausted"
+        journal["terminal"] = "recovery_exhausted"
+        self._integrity()
+        return RecoveryObservation(journal, None)
