+    )
+    assert calls == ["look", "wait", "wait"] * 7
+    assert result["orientation"]["end_frame"] == 69
+
+
+def test_only_motor_marker_changes_and_parent_schema_cannot_disguise_walking():
+    new, parent = (
+        stable.StableOrientedWalkKeyframePolicy(),
+        stable.StableOrientedJumpKeyframePolicy(),
