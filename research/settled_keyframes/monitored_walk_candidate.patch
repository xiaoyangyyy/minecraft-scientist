+
+def receipt(frame, kind="wait", handle=None, **changes):
+    return PublicControlStep(
+        **(
+            {
+                "frame": frame,
+                "executed_kind": kind,
+                "executed_handle": handle,
+                "compliant": True,
+                "ticks": 1,
+            }
+            | changes
+        )
+    )
+
+
+def test_all_moves_and_waits_check_every_frozen_model(fixture):
+    frozen, frames, calls = fixture
+    before = copy.deepcopy(frozen)
+    monitor = risk.FrozenMapMonitor(frozen, frames)
+    first = monitor.observe(
+        receipt(frames[-1], "move", 0), kind="move", handle=0, absolute_frame=102
+    )
+    second = monitor.observe(
+        receipt(frames[-1]), kind="wait", handle=None, absolute_frame=103
+    )
+    assert first["status"] == second["status"] == "observable"
+    assert [call[0] for call in calls] == [2, 3, 4, 5] * 2
+    assert [call[2] for call in calls] == [(6,)] * 4 + [(7,)] * 4
+    assert frozen == before
+    assert first["motion_validated"] is False
+    assert monitor.journal["navigation_accepted"] is False
+    first["candidates"].clear()
+    assert len(monitor.journal["records"][0]["candidates"]) == 4
+
+
+@pytest.mark.parametrize(
+    "status,state,counterexample",
