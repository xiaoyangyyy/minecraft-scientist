+
+@pytest.mark.parametrize("seed", [0, 19, 207])
+def test_native_variant_changes_buttons_not_anonymous_public_handles(
+    scripts, recorder, seed
+):
+    _, definition = scripts
+    rgb = np.zeros((448, 448, 3), np.uint8)
+    controllers = [
+        definition.keyframe_recorder(
+            recorder, jump_controls=True, walking_controls=flag
+        )
+        for flag in (False, True)
+    ]
+    scenes = [controller.perceive(rgb, {}, seed=seed) for controller in controllers]
+    assert scenes[0].objects == scenes[1].objects
+    for index, (controller, scene) in enumerate(zip(controllers, scenes, strict=True)):
+        targets = [
+            obj for obj in scene.objects if obj.affordances == (ActionKind.MOVE,)
+        ]
+        assert len(targets) == 4
+        for cardinal, target in zip(
+            ("forward", "back", "left", "right"), targets, strict=True
+        ):
+            assert cardinal not in repr(target) and "jump" not in repr(target)
+            payload = controller.encode_action(
+                PrimitiveAction(kind=ActionKind.MOVE, target_id=target.object_id), scene
+            )
+            assert int(payload["jump"]) == 1 - index
+            assert [
+                key for key in ("forward", "back", "left", "right") if int(payload[key])
+            ] == [cardinal]
+            assert not int(payload["sprint"]) and not int(payload["sneak"])
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"jump_controls": 1},
+        {"jump_controls": True, "walking_controls": "true"},
+        {"jump_controls": True, "walking_controls": None},
+        {"jump_controls": False, "walking_controls": True},
+    ],
+)
+def test_native_motor_variant_refuses_untyped_or_missing_parent(scripts, kwargs):
+    _, definition = scripts
+    with pytest.raises(ValueError):
+        definition.keyframe_recorder(forbidden, **kwargs)
+
+
+@pytest.mark.parametrize("walking", [False, True])
+def test_wrapper_preserves_actual_orientation_and_future_tick_costs(
+    monkeypatch, walking
+):
+    first = texture(448)
+    monkeypatch.setattr(orientation, "rank_views", lambda *args: {"selected_frame": 33})
+    calls = []
+
+    def execute(kind):
+        calls.append(kind)
+        return orientation.SurveyReceipt(first.copy(), kind, kind == "look", True, 1)
+
+    def acquire(frame, controller, camera, **kwargs):
+        assert kwargs["anchor_frame"] == 69 and kwargs["walking_controls"] is walking
+        assert kwargs["oriented_controls"] and kwargs["long_wait_controls"]
+        policy = kwargs["policy"]
+        expected = (
+            stable.StableOrientedWalkKeyframePolicy
+            if walking
+            else stable.StableOrientedJumpKeyframePolicy
+        )
+        assert type(policy) is expected
+        assert policy.move_ticks == 1 and policy.validation_move_ticks == 2
+        assert policy.maximum_episode_actions == 288
+        return {"test_only": True}
+
+    monkeypatch.setattr(stable, "acquire_stable_keyframe_map", acquire)
+    result = orientation.run_oriented_keyframe_map(
