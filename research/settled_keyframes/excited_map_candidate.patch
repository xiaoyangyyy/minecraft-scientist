+"""One genuinely new public map after a sealed parent's passive recovery.
+
+The actual episode clock and acquisition/recovery budgets are shared. Old maps,
+failed predictions and gauges are never rewritten, stitched or reinstated. A
+validated child remains a local camera-motion claim, not body/navigation proof.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+from typing import Literal
+
+from pydantic import BaseModel, ConfigDict, Field, StrictInt, StrictStr, model_validator
+
+from .map_recovery import _digest
+from .public_map_risk import MapRiskPolicy
+from .public_view_orientation import run_oriented_keyframe_map
+from .settled_map_control import PublicControlStep
+from .stable_keyframe_map import (
+    StableExcitedReacquiringWalkPolicy,
+    StableMonitoredWalkKeyframePolicy,
+    StableReacquiringWalkKeyframePolicy,
+    acquire_stable_keyframe_map,
+)
+from .visual_geometry import _frame
+
+SHA256 = r"^[0-9a-f]{64}$"
+COMPLETED_LOCAL_TERMINALS = frozenset(
+    {
+        "validated",
+        "rejected",
+        "map_unavailable",
+        "initial_wait_exhausted",
+        "acquisition_wait_exhausted",
+        "future_wait_exhausted",
+        "budget_exhausted",
+        "epoch_budget_exhausted",
+        "map_risk_reacquisition_ready",
+        "map_risk_recovery_exhausted",
+        "map_risk_budget_exhausted",
+        "map_risk_recovery_budget_exhausted",
+    }
+)
+PARENT_FIELDS = frozenset(
+    {
+        "anchor_frame",
+        "attempts",
+        "camera",
+        "continuous_raw_identity",
+        "control_choices",
+        "epoch_links",
+        "epochs",
+        "failed_wait_windows",
+        "failure",
+        "flow_prefixes",
+        "frozen",
+        "frozen_sha256",
+        "future",
+        "future_control_choice",
+        "global_gauge_aligned",
+        "map_risk",
+        "map_risk_recovery",
+        "map_risk_registration",
+        "metric_scale_known",
+        "micro_control_registration",
+        "motion",
+        "movement_program_registration",
+        "navigation_accepted",
+        "orientation_registration",
+        "policy",
+        "recovery_control_registration",
+        "recovery_wait_windows",
+        "response_control_registration",
+        "samples",
+        "seed",
+        "seed_detection_registration",
+        "settles",
+        "settling_window_registration",
+        "steps",
+        "terminal",
+        "visual_stability_only",
+        "walking_control_registration",
+    }
+)
+
+
+class EpochContinuation(BaseModel):
+    """Public lineage and remaining budgets, not a fabricated startup ordinal."""
+
+    model_config = ConfigDict(extra="forbid", frozen=True)
+    registration: Literal["unconnected-public-map-epoch-v1"] = (
+        "unconnected-public-map-epoch-v1"
+    )
+    anchor_frame: StrictInt = Field(ge=0, le=288)
+    namespace: StrictStr
+    rgb_sha256: StrictStr = Field(pattern=SHA256)
+    parent_acquisition_sha256: StrictStr = Field(pattern=SHA256)
+    parent_map_sha256: StrictStr = Field(pattern=SHA256)
+    remaining_acquisition_trials: StrictInt = Field(ge=0, le=22)
+    remaining_local_epochs: StrictInt = Field(ge=0, le=2)
+    remaining_acquisition_windows: StrictInt = Field(ge=0, le=2)
+    remaining_passive_windows: StrictInt = Field(ge=0, le=2)
+    connection_supported: Literal[False] = False
+
+    @model_validator(mode="after")
+    def _namespace(self):
+        if self.namespace != f"unconnected-risk-recovery-{self.anchor_frame}":
+            raise ValueError("new epoch must use the original recovery namespace")
+        return self
+
+
+class MapEpochPolicy(BaseModel):
+    model_config = ConfigDict(extra="forbid", frozen=True)
+    registration: Literal["bounded-unconnected-map-reacquisition-v1"] = (
+        "bounded-unconnected-map-reacquisition-v1"
+    )
+    maximum_child_epochs: Literal[1] = 1
+    maximum_episode_actions: Literal[288] = 288
+    maximum_acquisition_trials: Literal[22] = 22
+    maximum_local_epochs: Literal[2] = 2
+    maximum_acquisition_windows: Literal[2] = 2
+    maximum_passive_windows: Literal[2] = 2
+    child_policy: StableReacquiringWalkKeyframePolicy = (
+        StableReacquiringWalkKeyframePolicy()
+    )
+
+    @model_validator(mode="before")
+    @classmethod
+    def _exact_budgets(cls, values):
+        if isinstance(values, dict) and any(
+            type(values.get(name, default)) is not int
+            for name, default in (
+                ("maximum_child_epochs", 1),
+                ("maximum_episode_actions", 288),
+                ("maximum_acquisition_trials", 22),
+                ("maximum_local_epochs", 2),
+                ("maximum_acquisition_windows", 2),
+                ("maximum_passive_windows", 2),
+            )
+        ):
+            raise ValueError("map-epoch budgets must be exact integers")
+        return values
+
+    @model_validator(mode="after")
+    def _unchanged_child_gates(self):
+        if self.child_policy != StableReacquiringWalkKeyframePolicy():
+            raise ValueError("new maps cannot relax the registered child gates")
+        return self
+
+
+class ExcitedMapEpochPolicy(MapEpochPolicy):
+    """Only child future hold length changes; shared budgets/gates stay exact."""
+
+    registration: Literal["bounded-four-move-map-reacquisition-v1"] = (
+        "bounded-four-move-map-reacquisition-v1"
+    )
+    child_policy: StableExcitedReacquiringWalkPolicy = (
+        StableExcitedReacquiringWalkPolicy()
+    )
+
+    @model_validator(mode="after")
+    def _unchanged_child_gates(self):
+        if self.child_policy != StableExcitedReacquiringWalkPolicy():
+            raise ValueError(
+                "stronger stimulus cannot relax the registered child gates"
+            )
+        return self
+
+
+def epoch_policy(policy=None, *, excited_controls=False):
+    if type(excited_controls) is not bool:
+        raise ValueError("stronger stimulus requires an explicit boolean registration")
+    policy_type = ExcitedMapEpochPolicy if excited_controls else MapEpochPolicy
+    return policy_type.model_validate(
+        policy.model_dump() if isinstance(policy, MapEpochPolicy) else policy or {}
+    )
+
+
+def map_epoch_protocol_completed(result):
+    """Capture sanity gate, not map/motion success or independent replay.
+
+    Passive recovery can retain a control/solver exception without an outer
+    failure field. Such a terminal must never be mistaken for a completed run.
+    """
+    orientation, parent, ledger = (
+        result["orientation"],
+        result["acquisition"],
+        result["map_epochs"],
+    )
+    children = ledger["children"]
+    acquisitions = ([] if parent is None else [parent]) + children
+    steps = [step for acquisition in acquisitions for step in acquisition["steps"]]
+    start = orientation["end_frame"]
+    return (
+        orientation.get("failure") is None
+        and orientation.get("terminal") in ("completed", "no_eligible_view")
+        and type(start) is int
+        and start == 48 + len(orientation["steps"]) <= 81
+        and ledger["failure"] is None
+        and len(children) <= 1
+        and len(ledger["links"]) == len(children)
+        and ledger["child_acquisition_attempted"] is bool(children)
+        and ledger["steps"] == steps
+        and type(ledger["end_frame"]) is int
+        and ledger["end_frame"] == start + len(steps) <= 288
+        and [step["absolute_frame"] for step in steps]
+        == list(range(start + 1, ledger["end_frame"] + 1))
+        and all(
+            step["compliant"] is True
+            and type(step["ticks"]) is int
+            and step["ticks"] == 1
+            for step in steps
+        )
+        and all(
+            acquisition["failure"] is None
+            and acquisition["terminal"] in COMPLETED_LOCAL_TERMINALS
+            for acquisition in acquisitions
+        )
+        and all(
+            ledger[name] is False
+            for name in (
+                "old_map_restored",
+                "global_gauge_aligned",
+                "metric_scale_known",
+                "navigation_accepted",
+            )
+        )
+    )
+
+
+def continuation_from_parent(
+    parent, latest_frame, *, policy=None, excited_controls=False
+):
+    """Called only after the producer returns; native audit replays its producer.
+
+    Bind the complete sealed parent, public failure and ACTUAL recovery endpoint.
+    No new input may serialize unregistered top-level private context.
+    """
+    settings = epoch_policy(policy, excited_controls=excited_controls)
+    if not isinstance(parent, dict) or set(parent) != PARENT_FIELDS:
+        raise ValueError("continuation requires the exact public parent journal")
+    if (
+        parent["terminal"] != "map_risk_reacquisition_ready"
+        or parent["failure"] is not None
+        or parent["future"] is not None
+        or parent["motion"] is not None
+        or parent["policy"]
+        != StableMonitoredWalkKeyframePolicy().model_dump(mode="json")
+        or parent["navigation_accepted"] is not False
+        or parent["global_gauge_aligned"] is not False
+        or parent["metric_scale_known"] is not False
+    ):
+        raise ValueError("new map requires a failed, non-navigating monitored parent")
+    risk, recovery, frozen = (
+        parent["map_risk"],
+        parent["map_risk_recovery"],
+        parent["frozen"],
+    )
+    if (
+        not isinstance(risk, dict)
+        or not isinstance(recovery, dict)
+        or not isinstance(frozen, dict)
+        or set(risk)
+        != {
+            "policy",
+            "parent_sha256",
+            "records",
+            "terminal",
+            "latent_cause",
+            "body_rest_known",
+            "motion_validated",
+            "navigation_accepted",
+        }
+        or any(
+            risk.get(name) is not False
+            for name in ("body_rest_known", "motion_validated", "navigation_accepted")
+        )
+        or risk.get("latent_cause") != "unidentified"
+        or set(recovery)
+        != {
+            "registration",
+            "parent_sha256",
+            "source_failure_sha256",
+            "anchor_frame",
+            "steps",
+            "windows",
+            "terminal",
+            "new_epoch",
+            "old_map_restored",
+            "gauge_connection_known",
+            "body_rest_known",
+            "motion_validated",
+            "navigation_accepted",
+        }
+        or recovery["registration"] != "bounded-passive-map-risk-recovery-v1"
+        or recovery["terminal"] != "reacquisition_ready"
+        or risk.get("terminal") not in ("challenged", "support_lost", "geometry_failed")
+        or risk.get("policy") != MapRiskPolicy().model_dump(mode="json")
+        or not risk.get("records")
+        or not 1 <= len(recovery["windows"]) <= 2
+    ):
+        raise ValueError("continuation requires the original public map-risk recovery")
+    for key in (
+        "old_map_restored",
+        "gauge_connection_known",
+        "body_rest_known",
+        "motion_validated",
+        "navigation_accepted",
+    ):
+        if recovery[key] is not False:
+            raise ValueError(
+                "passive recovery cannot assert restored/connected/body motion"
+            )
+    endpoint = recovery["new_epoch"]
+    if not isinstance(endpoint, dict) or set(endpoint) != {
+        "namespace",
+        "anchor_frame",
+        "rgb_sha256",
+        "parent_sha256",
+        "connection_supported",
+    }:
+        raise ValueError("continuation requires the exact unconnected endpoint schema")
+    image = _frame(latest_frame)
+    actual_end = parent["anchor_frame"] + len(parent["steps"])
+    if (
+        type(endpoint["anchor_frame"]) is not int
+        or endpoint["anchor_frame"] != actual_end
+        or endpoint["connection_supported"] is not False
+        or hashlib.sha256(image.tobytes()).hexdigest() != endpoint["rgb_sha256"]
+        or [step["absolute_frame"] for step in parent["steps"]]
+        != list(range(parent["anchor_frame"] + 1, actual_end + 1))
+        or any(
+            step["compliant"] is not True
+            or type(step["ticks"]) is not int
+            or step["ticks"] != 1
+            for step in parent["steps"]
+        )
+        or not recovery["steps"]
+        or [step["absolute_frame"] for step in recovery["steps"]]
+        != list(range(recovery["anchor_frame"] + 1, actual_end + 1))
+        or recovery["steps"][-1].get("rgb_sha256") != endpoint["rgb_sha256"]
+        or risk["records"][-1]["absolute_frame"] != recovery["anchor_frame"]
+        or len(recovery["steps"]) < 8
+        or any(
+            step.get("flow", {}).get("stable") is not True
+            for step in recovery["steps"][-3:]
+        )
+    ):
+        raise ValueError(
+            "continuation cannot skip actions or fabricate a ready image/clock"
+        )
+    window_start = recovery["anchor_frame"]
+    for number, window in enumerate(recovery["windows"]):
+        if (
+            type(window["number"]) is not int
+            or window["number"] != number
+            or window["start_frame"] != window_start
+            or type(window["end_frame"]) is not int
+            or not 8 <= window["end_frame"] - window_start <= 24
+            or window["status"]
+            != (
+                "reacquisition_ready"
+                if number == len(recovery["windows"]) - 1
+                else "exhausted"
+            )
+            or number < len(recovery["windows"]) - 1
+            and window["end_frame"] - window_start != 24
+        ):
+            raise ValueError("continuation changed the actual passive window budget")
+        window_start = window["end_frame"]
+    if window_start != actual_end:
+        raise ValueError("passive windows do not end at the actual ready image")
+    map_sha = _digest(frozen)
+    if (
+        parent["frozen_sha256"] != map_sha
+        or endpoint["parent_sha256"] != map_sha
+        or risk["parent_sha256"] != map_sha
+        or recovery["parent_sha256"] != map_sha
+        or recovery["source_failure_sha256"] != _digest(risk["records"][-1])
+    ):
+        raise ValueError("continuation changed the sealed failed map or its failure")
+    counts = (
+        len(parent["control_choices"]),
+        len(parent["epochs"]),
+        len(parent["recovery_wait_windows"]),
+        len(recovery["windows"]),
+    )
+    maxima = (
+        settings.maximum_acquisition_trials,
+        settings.maximum_local_epochs,
+        settings.maximum_acquisition_windows,
+        settings.maximum_passive_windows,
+    )
+    if any(count > maximum for count, maximum in zip(counts, maxima, strict=True)):
+        raise ValueError("parent exceeded the registered shared epoch budgets")
+    return EpochContinuation(
+        anchor_frame=actual_end,
+        namespace=endpoint["namespace"],
+        rgb_sha256=endpoint["rgb_sha256"],
+        parent_map_sha256=map_sha,
+        parent_acquisition_sha256=_digest(parent),
+        remaining_acquisition_trials=maxima[0] - counts[0],
+        remaining_local_epochs=maxima[1] - counts[1],
+        remaining_acquisition_windows=maxima[2] - counts[2],
+        remaining_passive_windows=maxima[3] - counts[3],
+    )
+
+
+def run_reacquiring_keyframe_maps(
+    references,
+    execute_orientation,
+    execute_acquisition,
+    camera,
+    *,
+    seed=2000,
+    policy=None,
+    startup_policy=None,
+    excited_controls=False,
+):
+    """An unchanged startup producer followed by at most one NEW local map."""
+    settings = epoch_policy(policy, excited_controls=excited_controls)
+    startup = StableMonitoredWalkKeyframePolicy.model_validate(
+        startup_policy.model_dump()
+        if isinstance(startup_policy, StableMonitoredWalkKeyframePolicy)
+        else startup_policy or {}
+    )
+    latest = None
+
+    def execute(kind, handle):
+        nonlocal latest
+        receipt = execute_acquisition(kind, handle)
+        if isinstance(receipt, PublicControlStep):
+            try:
+                latest = _frame(receipt.frame).copy()
+            except (TypeError, ValueError):
+                latest = None  # producer retains/classifies the actual failed receipt
+        return receipt
+
+    result = run_oriented_keyframe_map(
+        references,
+        execute_orientation,
+        execute,
+        camera,
+        seed=seed,
+        policy=startup,
+        walking_controls=True,
+        risk_controls=True,
+    )
+    parent = result["acquisition"]
+    ledger = {
+        "policy": settings.model_dump(mode="json"),
+        "children": [],
+        "links": [],
+        "steps": copy.deepcopy((parent or {}).get("steps", [])),
+        "end_frame": result["orientation"]["end_frame"]
+        + len((parent or {}).get("steps", [])),
+        "terminal": f"startup_{(parent or {}).get('terminal', 'no_eligible_view')}",
+        "failure": None,
+        "child_acquisition_attempted": False,
+        "old_map_restored": False,
+        "global_gauge_aligned": False,
+        "metric_scale_known": False,
+        "navigation_accepted": False,
+    }
+    result["map_epochs"] = ledger
+    if parent is None or parent["terminal"] != "map_risk_reacquisition_ready":
+        return result
+    continuation = continuation_from_parent(
+        parent, latest, policy=settings, excited_controls=excited_controls
+    )
+    parent_sha = continuation.parent_acquisition_sha256
+    ledger["parent_acquisition_sha256"] = parent_sha
+    if (
+        continuation.anchor_frame >= 288
+        or continuation.remaining_acquisition_trials == 0
+        or continuation.remaining_local_epochs == 0
+    ):
+        ledger["terminal"] = "shared_epoch_budget_exhausted"
+        return result
+    child = acquire_stable_keyframe_map(
+        latest.copy(),
+        execute,
+        camera,
+        anchor_frame=continuation.anchor_frame,
+        seed=seed,
+        policy=settings.child_policy,
+        continuation=continuation,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        oriented_controls=True,
+        walking_controls=True,
+        risk_controls=True,
+        epoch_controls=True,
+        excited_controls=excited_controls,
+    )
+    if _digest(parent) != parent_sha:
+        raise ValueError("child acquisition changed the sealed parent history")
+    ledger["child_acquisition_attempted"] = True
+    ledger["children"].append(child)
+    ledger["steps"].extend(copy.deepcopy(child["steps"]))
+    ledger["end_frame"] = child["anchor_frame"] + len(child["steps"])
+    ledger["terminal"] = f"child_{child['terminal']}"
+    ledger["failure"] = child["failure"]
+    ledger["links"].append(
+        {
+            "parent_acquisition_sha256": parent_sha,
+            "parent_map_sha256": continuation.parent_map_sha256,
+            "child_acquisition_sha256": _digest(child),
+            "continuation": continuation.model_dump(mode="json"),
+            "connection_supported": False,
+            "global_gauge_aligned": False,
+            "navigation_accepted": False,
+        }
+    )
+    if ledger["end_frame"] > 288 or [
+        step["absolute_frame"] for step in ledger["steps"]
+    ] != list(range(parent["anchor_frame"] + 1, ledger["end_frame"] + 1)):
+        raise ValueError("new map epochs changed the actual global action clock")
+    return result
