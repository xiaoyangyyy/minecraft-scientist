+@pytest.mark.parametrize("outcome", ["validated", "rejected", "challenged"])
+def test_new_actual_anchor_gets_fresh_namespace_and_gates_without_parent_mutation(
+    ready, monkeypatch, outcome
+):
+    parent, _, _, scene, _ = ready
+    original = copy.deepcopy(parent)
+    calls_before = len(scene[2])
+    if outcome != "challenged":
+        monkeypatch.setattr(
+            risk,
+            "validate_joint_future",
+            lambda model, *args, **kwargs: {
+                "status": "consistent" if model.supported else "unavailable",
+                "navigation_accepted": False,
+            },
+        )
+        monkeypatch.setattr(
+            stable,
+            "validate_joint_future",
+            lambda model, past, extended, **kwargs: {
+                "status": "consistent"
+                if model.supported and outcome == "validated"
+                else "inconsistent"
+                if model.supported
+                else "unavailable",
+                "poses": [
+                    {
+                        "frame_slot": extended.frame_count - 1,
+                        "rotation": np.eye(3).tolist(),
+                        "translation": [-10, 0, 0],
+                    }
+                ],
+            },
+        )
+    result = child(ready)
+    assert result["terminal"] == (
+        "map_risk_reacquisition_ready" if outcome == "challenged" else outcome
+    )
+    continuation = result["continuation"]
+    assert (
+        result["anchor_frame"]
+        == parent["map_risk_recovery"]["new_epoch"]["anchor_frame"]
+    )
+    assert result["frozen"]["index"]["namespace"].startswith(
+        continuation["namespace"] + "/"
+    )
+    assert (
+        result["frozen"]["index"]["namespace"] != parent["frozen"]["index"]["namespace"]
+    )
+    assert len(scene[2]) - calls_before == len(result["steps"])
+    assert [step["absolute_frame"] for step in result["steps"]] == list(
+        range(
+            result["anchor_frame"] + 1,
+            result["anchor_frame"] + 1 + len(result["steps"]),
+        )
+    )
+    assert parent == original
+    assert not result["global_gauge_aligned"] and not result["navigation_accepted"]
+    assert result["policy"]["fitting"] == parent["policy"]["fitting"]
+    if outcome == "challenged":
+        recovery = result["map_risk_recovery"]
+        assert recovery["remaining_window_budget"] == 1
+        assert (
+            len(recovery["windows"]) + len(parent["map_risk_recovery"]["windows"]) <= 2
+        )
+        assert not recovery["old_map_restored"]
