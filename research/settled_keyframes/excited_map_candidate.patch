+++ b/tests/unit/test_excited_map_epoch.py
@@ -0,0 +1,217 @@
+"""Real RGB/receipts with explicit model/flow doubles; NOT native motion proof."""
+
+import copy
+
+import numpy as np
+import pytest
+from pydantic import ValidationError
+from test_map_epoch_reacquisition import ready as ready  # noqa: PLC0414
+from test_public_map_risk import fixture as fixture  # noqa: PLC0414
+from test_public_map_risk_controller import FLAGS
+from test_public_map_risk_controller import scene as scene  # noqa: PLC0414
+
+from minecraft_scientist.exploration import map_epoch_reacquisition as epochs
+from minecraft_scientist.exploration import public_map_risk as risk
+from minecraft_scientist.exploration import stable_keyframe_map as stable
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+
+
+def test_only_child_future_stimulus_changes_not_gates_or_budgets():
+    old = epochs.MapEpochPolicy().model_dump(mode="json")
+    new = epochs.ExcitedMapEpochPolicy().model_dump(mode="json")
+    assert (
+        new["child_policy"].pop("future_stimulus_registration")
+        == "fixed-four-move-child-future-v1"
+    )
+    assert new.pop("registration") == "bounded-four-move-map-reacquisition-v1"
+    old.pop("registration")
+    assert new["child_policy"].pop("validation_move_ticks") == 4
+    assert old["child_policy"].pop("validation_move_ticks") == 2
+    assert new == old
+
+
+@pytest.mark.parametrize("ticks", [2, 3, 5, True, 4.0, "4"])
+def test_stimulus_length_is_fixed_and_exact(ticks):
+    with pytest.raises(ValidationError):
+        stable.StableExcitedReacquiringWalkPolicy(validation_move_ticks=ticks)
+
+
+@pytest.mark.parametrize("flag", [True, False])
+def test_registered_profiles_cannot_be_disguised_as_each_other(flag):
+    wrong = epochs.MapEpochPolicy() if flag else epochs.ExcitedMapEpochPolicy()
+    with pytest.raises(ValidationError):
+        epochs.epoch_policy(wrong, excited_controls=flag)
+
+
+@pytest.mark.parametrize("flag", [1, "true", None])
+def test_stimulus_flag_requires_exact_boolean_before_dispatch(flag):
+    forbidden = lambda *args: pytest.fail("dispatched")
+    with pytest.raises(ValueError, match="boolean"):
+        stable.acquire_stable_keyframe_map(
+            None, forbidden, None, anchor_frame=0, excited_controls=flag
+        )
+    with pytest.raises(ValueError, match="boolean"):
+        epochs.run_reacquiring_keyframe_maps(
+            [], forbidden, forbidden, None, excited_controls=flag
+        )
+
+
+def test_stimulus_cannot_be_enabled_for_old_startup_or_plain_child():
+    with pytest.raises(ValueError, match="genuine child"):
+        stable.acquire_stable_keyframe_map(
+            None,
+            lambda *args: pytest.fail("dispatched"),
+            None,
+            anchor_frame=0,
+            excited_controls=True,
+        )
+
+
+def consistent_models(monkeypatch):
+    # Pose/model dispatch double, not a claim of correct native geometry.
+    monkeypatch.setattr(
+        risk,
+        "validate_joint_future",
+        lambda model, *args, **kwargs: {
+            "status": "consistent" if model.supported else "unavailable",
+            "navigation_accepted": False,
+        },
+    )
+    monkeypatch.setattr(
+        stable,
+        "validate_joint_future",
+        lambda model, past, extended, **kwargs: {
+            "status": "consistent" if model.supported else "unavailable",
+            "poses": [
+                {
+                    "frame_slot": extended.frame_count - 1,
+                    "rotation": np.eye(3).tolist(),
+                    "translation": [-10, 0, 0],
+                }
+            ],
+        },
+    )
+
+
+def excited_child(ready, *, context=None):
+    parent, image, dispatch, _, _ = ready
+    context = context or epochs.continuation_from_parent(
+        parent, image, excited_controls=True
+    )
+    return stable.acquire_stable_keyframe_map(
+        image,
+        dispatch,
+        np.eye(3),
+        anchor_frame=context.anchor_frame,
+        continuation=context,
+        epoch_controls=True,
+        excited_controls=True,
+        **FLAGS,
+    )
+
+
+def test_all_four_actual_moves_are_monitored_before_original_final_gates(
+    ready, monkeypatch
+):
+    parent, _, _, scene, _ = ready
+    original, before = copy.deepcopy(parent), len(scene[2])
+    consistent_models(monkeypatch)
+    child = excited_child(ready)
+    assert child["terminal"] == "validated"
+    assert child["future_stimulus_registration"] == "fixed-four-move-child-future-v1"
+    first, records = child["frozen"]["frozen_at_frame"], child["map_risk"]["records"]
+    assert [record["absolute_frame"] for record in records] == list(
+        range(first + 1, first + 13)
+    )
+    assert [record["requested_kind"] for record in records] == ["move"] * 4 + [
+        "wait"
+    ] * 8
+    assert len(scene[2]) - before == len(child["steps"]) == 65
+    assert child["future"]["absolute_frame"] == first + 12
+    assert parent == original and not child["navigation_accepted"]
+    assert not child["metric_scale_known"] and not child["global_gauge_aligned"]
+
+
+def test_failed_third_move_prevents_fourth_and_keeps_shared_recovery(
+    ready, monkeypatch
+):
+    parent, _, _, _, _ = ready
+    original = copy.deepcopy(parent)
+
+    def validate(model, past, extended, **kwargs):
+        tick = extended.frame_count - past.frame_count
+        return {
+            "status": "inconsistent"
+            if tick == 3 and model.supported
+            else "consistent"
+            if model.supported
+            else "unavailable"
+        }
+
+    monkeypatch.setattr(risk, "validate_joint_future", validate)
+    child = excited_child(ready)
+    assert child["terminal"] == "map_risk_reacquisition_ready"
+    records = child["map_risk"]["records"]
+    assert len(records) == 3 and records[-1]["status"] == "challenged"
+    assert [record["requested_kind"] for record in records] == ["move"] * 3
+    assert len(child["map_risk_recovery"]["steps"]) == 8
+    assert child["map_risk_recovery"]["remaining_window_budget"] == 1
+    assert child["future"] is None and child["motion"] is None
+    assert parent == original and not child["map_risk_recovery"]["old_map_restored"]
+
+
+def test_stronger_stimulus_still_stops_at_original_global_clock(ready, monkeypatch):
+    parent, image, _, _, _ = ready
+    fields = epochs.continuation_from_parent(parent, image).model_dump()
+    # Artificial ordinal tests dispatch cap only, not an actual native endpoint.
+    context = epochs.EpochContinuation.model_validate(
+        fields | {"anchor_frame": 228, "namespace": "unconnected-risk-recovery-228"}
+    )
+    consistent_models(monkeypatch)
+    child = excited_child(ready, context=context)
+    assert child["terminal"] == "budget_exhausted"
+    assert child["steps"][-1]["absolute_frame"] == 288
+    assert len(child["steps"]) == 60 and child["motion"] is None
+    assert child["future"] is None and not child["navigation_accepted"]
+
+
+def test_orchestrator_keeps_old_startup_and_passes_explicit_child_profile(
+    ready, monkeypatch
+):
+    parent, image, _, _, _ = ready
+    captured = []
+
+    def startup(refs, orient, execute, camera, **kwargs):
+        assert kwargs["policy"] == stable.StableMonitoredWalkKeyframePolicy()
+        assert kwargs["policy"].validation_move_ticks == 2
+        execute("wait", None)
+        return {
+            "orientation": {"end_frame": parent["anchor_frame"]},
+            "acquisition": parent,
+        }
+
+    def child(first, execute, camera, **kwargs):
+        captured.append(kwargs)
+        return {
+            "anchor_frame": kwargs["anchor_frame"],
+            "steps": [],
+            "terminal": "unit_only",
+            "failure": None,
+        }
+
+    monkeypatch.setattr(epochs, "run_oriented_keyframe_map", startup)
+    monkeypatch.setattr(epochs, "acquire_stable_keyframe_map", child)
+    result = epochs.run_reacquiring_keyframe_maps(
+        [image] * 12,
+        lambda *args: pytest.fail("reoriented"),
+        lambda *args: PublicControlStep(image.copy(), "wait", None, True, 1),
+        np.eye(3),
+        excited_controls=True,
+    )
+    assert captured[0]["excited_controls"] is True
+    assert captured[0]["policy"].validation_move_ticks == 4
+    assert (
+        result["map_epochs"]["policy"]["registration"]
+        == "bounded-four-move-map-reacquisition-v1"
+    )
+    assert not result["map_epochs"]["global_gauge_aligned"]
