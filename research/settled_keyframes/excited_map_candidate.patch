+def keyframe_recorder(recorder_type, *, jump_controls, walking_controls=False):
+    """Bind the declared motor variant before reset, not from later outcomes."""
+    if type(jump_controls) is not bool or type(walking_controls) is not bool:
+        raise ValueError("motor variant requires exact explicit booleans")
+    if walking_controls and not jump_controls:
+        raise ValueError("walking replacement requires explicit parent registration")
+    return recorder_type(jump_controls=jump_controls and not walking_controls)
+
+
+def completed_map_epochs(keyframes, policy, action_count):
+    """A producer exception/partial journal must preserve a failed capture report."""
+    from minecraft_scientist.exploration.map_epoch_reacquisition import (
+        map_epoch_protocol_completed,
+    )
+
+    if not isinstance(keyframes, dict):
+        return False
+    try:
+        return (
+            map_epoch_protocol_completed(keyframes)
+            and keyframes["map_epochs"]["policy"] == policy
+            and type(action_count) is int
+            and keyframes["map_epochs"]["end_frame"] == action_count
+        )
+    except (KeyError, TypeError, ValueError):
+        return False
+
