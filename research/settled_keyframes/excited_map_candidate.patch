+@pytest.fixture
+def ready(scene, monkeypatch):
+    _, dispatch, _, _ = scene
+    images = []
+
+    def execute(kind, handle):
+        receipt = dispatch(kind, handle)
+        images.append(receipt.frame.copy())
+        return receipt
+
+    monkeypatch.setattr(
+        risk,
+        "validate_joint_future",
+        lambda model, *args, **kwargs: {
+            "status": "inconsistent" if model.supported else "unavailable",
+            "navigation_accepted": False,
+        },
+    )
+    parent = run(scene, execute=execute)
+    assert parent["terminal"] == "map_risk_reacquisition_ready"
+    return parent, images[-1].copy(), execute, scene, images
+
+
+def child(ready, *, context=None, execute=None):
+    parent, image, dispatch, _, _ = ready
+    continuation = context or epochs.continuation_from_parent(parent, image)
+    return stable.acquire_stable_keyframe_map(
+        image,
+        execute or dispatch,
+        np.eye(3),
+        anchor_frame=continuation.anchor_frame,
+        continuation=continuation,
+        epoch_controls=True,
+        **FLAGS,
+    )
+
+
+def test_actual_ready_anchor_and_remaining_budgets_bind_complete_sealed_parent(ready):
+    parent, image, _, _, _ = ready
+    continuation = epochs.continuation_from_parent(parent, image)
+    assert (
+        continuation.anchor_frame == parent["anchor_frame"] + len(parent["steps"]) > 81
+    )
+    assert (
+        continuation.namespace == parent["map_risk_recovery"]["new_epoch"]["namespace"]
+    )
+    assert continuation.parent_map_sha256 == parent["frozen_sha256"]
+    assert continuation.parent_acquisition_sha256 == epochs._digest(parent)
+    assert continuation.remaining_acquisition_trials == 17
+    assert continuation.remaining_local_epochs == 1
+    assert continuation.remaining_acquisition_windows == 2
+    assert continuation.remaining_passive_windows == 1
+    assert not continuation.connection_supported
+
