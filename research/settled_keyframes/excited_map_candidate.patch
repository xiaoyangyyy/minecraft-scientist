+def test_forged_recovery_cannot_start_a_new_map(ready, case):
+    parent, image, _, _, _ = ready
+    parent = copy.deepcopy(parent)
+    recovery = parent["map_risk_recovery"]
+    if case == "map-hash":
+        parent["frozen_sha256"] = "0" * 64
+    elif case == "failure-hash":
+        recovery["source_failure_sha256"] = "0" * 64
+    elif case == "clock":
+        recovery["new_epoch"]["anchor_frame"] += 1
+    elif case == "image-hash":
+        recovery["new_epoch"]["rgb_sha256"] = "0" * 64
+    elif case == "skipped-step":
+        parent["steps"].pop(0)
+    elif case == "rest":
+        recovery["body_rest_known"] = True
+    elif case == "connected":
+        recovery["new_epoch"]["connection_supported"] = True
+    elif case == "motion":
+        parent["motion"] = {"supported": True}
+    elif case == "future":
+        parent["future"] = {"accepted": True}
+    elif case == "empty-windows":
+        recovery["windows"] = []
+    elif case == "window-number":
+        recovery["windows"][0]["number"] = True
+    else:
+        recovery["steps"][-1]["flow"]["stable"] = False
+    with pytest.raises(ValueError):
+        epochs.continuation_from_parent(parent, image)
