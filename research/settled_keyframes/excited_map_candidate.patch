+"""Independent public-first stronger-stimulus protocol tests, not native success."""
+
+import json
+import sys
+
+import pytest
+from test_runtime_camera_audit import (
+    diagnostic as diagnostic,  # noqa: PLC0414
+)
+from test_runtime_camera_audit import (
+    private_guard,
+    save,
+)
+from test_runtime_camera_audit import (
+    scripts as scripts,  # noqa: PLC0414
+)
+from test_stable_keyframe_audit import (
+    keyframe_capture as keyframe_capture,  # noqa: PLC0414
+)
+
+
+@pytest.mark.parametrize(
+    "keyframe_capture", ["excited", "excited-abstain"], indirect=True
+)
+def test_stronger_profile_is_replayed_before_private_reads(
+    keyframe_capture, monkeypatch
+):
+    auditor, route, engine = keyframe_capture
+    with monkeypatch.context() as guards:
+        private_guard(guards)
+        assert auditor.runtime.public_data(
+            route, engine, registration=auditor.registration
+        )["valid"]
+    result = auditor.audit(route, engine)
+    assert result["valid"] and result["evaluation"] is None
+    assert result["map_epoch_evaluation"]["children"] == []
+    assert not result["navigation_accepted"]
+
+
+@pytest.mark.parametrize("keyframe_capture", ["excited"], indirect=True)
+@pytest.mark.parametrize(
+    "case",
+    [
+        "old-schema",
+        "old-profile",
+        "old-child",
+        "omit-stimulus",
+        "too-long",
+        "relaxed-gate",
+        "changed-shared-budget",
+        "changed-startup",
+        "invented-future",
+    ],
+)
+def test_stimulus_disguise_or_relaxed_gates_cannot_open_private_files(
+    keyframe_capture, monkeypatch, case
+):
+    auditor, route, engine = keyframe_capture
+    config = json.loads((route / "config.json").read_bytes())
+    saved = json.loads((route / "keyframe-acquisition.json").read_bytes())
+    child = config["map_epoch_policy"]["child_policy"]
+    if case == "old-schema":
+        config["schema"] = "reacquiring-monitored-walking-keyframe-camera-projection-v1"
+    elif case == "old-profile":
+        config["map_epoch_policy"]["registration"] = (
+            "bounded-unconnected-map-reacquisition-v1"
+        )
+    elif case == "old-child":
+        child["validation_move_ticks"] = 2
+    elif case == "omit-stimulus":
+        child.pop("future_stimulus_registration")
+    elif case == "too-long":
+        child["validation_move_ticks"] = 5
+    elif case == "relaxed-gate":
+        child["minimum_translation_ratio"] = 0.001
+    elif case == "changed-shared-budget":
+        config["map_epoch_policy"]["maximum_episode_actions"] = 300
+    elif case == "changed-startup":
+        config["keyframe_policy"]["validation_move_ticks"] = 4
+    else:
+        saved["map_epochs"]["children"] = [
+            {
+                "terminal": "validated",
+                "future_stimulus_registration": "fixed-four-move-child-future-v1",
+            }
+        ]
+    save(route / "config.json", config)
+    save(route / "keyframe-acquisition.json", saved)
+    report = json.loads((route / "report.json").read_bytes())
+    report["config_sha256"] = auditor.runtime.digest(route / "config.json")
+    report["artifact_sha256"]["keyframe-acquisition.json"] = auditor.runtime.digest(
+        route / "keyframe-acquisition.json"
+    )
+    save(route / "report.json", report)
+    private_guard(monkeypatch)
+    result = auditor.audit(route, engine)
+    assert not result["valid"] and result["evaluation"] is None
+    assert result.get("map_epoch_evaluation") is None
+    assert result["stability_diagnostics"] is None
+
+
+@pytest.mark.parametrize(
+    "flags",
+    [
+        ["--excited-keyframes"],
+        [
+            "--excited-keyframes",
+            "--risk-keyframes",
+            "--walking-keyframes",
+            "--oriented-keyframes",
+            "--long-wait-keyframes",
+            "--jump-keyframes",
+            "--safe-seed-keyframes",
+            "--recovering-keyframes",
+            "--responsive-keyframes",
+            "--micro-keyframes",
+            "--stable-keyframes",
+        ],
+    ],
+)
+def test_stronger_cli_requires_actual_reacquisition_before_output(
+    scripts, tmp_path, monkeypatch, flags
+):
+    _, capture = scripts
+    output = tmp_path / "must-not-exist"
+    monkeypatch.setattr(
+        sys, "argv", [capture.__file__, *flags, "--output", str(output)]
+    )
+    with pytest.raises(SystemExit):
+        capture.main()
+    assert not output.exists()
