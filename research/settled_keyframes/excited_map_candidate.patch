+"""Public-first epoch registration; mock captures are NOT native map success."""
+
+import copy
+import json
+import sys
+
+import numpy as np
+import pytest
+from test_runtime_camera_audit import (
+    diagnostic as diagnostic,  # noqa: PLC0414 -- fixture re-export
+)
+from test_runtime_camera_audit import (
+    private_guard,
+    save,
+)
+from test_runtime_camera_audit import (
+    scripts as scripts,  # noqa: PLC0414 -- fixture re-export
+)
+from test_stable_keyframe_audit import (
+    keyframe_capture as keyframe_capture,  # noqa: PLC0414 -- fixture re-export
+)
+
+
+@pytest.mark.parametrize(
+    "keyframe_capture", ["reacquire", "reacquire-abstain"], indirect=True
+)
+def test_new_epoch_public_replay_precedes_private_scoring(
+    keyframe_capture, monkeypatch
+):
+    auditor, route, engine = keyframe_capture
+    with monkeypatch.context() as guards:
+        private_guard(guards)
+        public = auditor.runtime.public_data(
+            route, engine, registration=auditor.registration
+        )
+        assert public["valid"]
+    result = auditor.audit(route, engine)
+    assert result["valid"] and result["evaluation"] is None
+    epochs = result["map_epoch_evaluation"]
+    assert epochs["children"] == [] and not epochs["child_acquisition_attempted"]
+    assert epochs["end_frame"] in (48, 99)
+    assert not epochs["navigation_accepted"] and not epochs["old_map_restored"]
+    assert not epochs["global_gauge_aligned"] and not epochs["metric_scale_known"]
+
+
+@pytest.mark.parametrize("keyframe_capture", ["reacquire"], indirect=True)
+@pytest.mark.parametrize(
+    "case",
+    [
+        "omit-policy",
+        "action-budget",
+        "trial-budget",
+        "epoch-budget",
+        "passive-budget",
+        "window-budget",
+        "child-count",
+        "child-gate",
+        "old-schema",
+        "omit-ledger",
+        "clock",
+        "skip-step",
+        "invented-child",
+        "invented-parent",
+        "invented-link",
+        "restored",
+        "gauge",
+        "metric",
+        "navigation",
+        "failure",
+        "missing-check",
+        "extra-context",
+    ],
+)
+def test_epoch_forgery_cannot_open_private_files(keyframe_capture, monkeypatch, case):
+    auditor, route, engine = keyframe_capture
+    config = json.loads((route / "config.json").read_bytes())
+    saved = json.loads((route / "keyframe-acquisition.json").read_bytes())
+    report = json.loads((route / "report.json").read_bytes())
+    ledger = saved["map_epochs"]
+    if case == "omit-policy":
+        config.pop("map_epoch_policy")
+    elif case in (
+        "action-budget",
+        "trial-budget",
+        "epoch-budget",
+        "passive-budget",
+        "window-budget",
+        "child-count",
+    ):
+        field = {
+            "action-budget": "maximum_episode_actions",
+            "trial-budget": "maximum_acquisition_trials",
+            "epoch-budget": "maximum_local_epochs",
+            "passive-budget": "maximum_passive_windows",
+            "window-budget": "maximum_acquisition_windows",
+            "child-count": "maximum_child_epochs",
+        }[case]
+        config["map_epoch_policy"][field] += 1
+    elif case == "child-gate":
+        config["map_epoch_policy"]["child_policy"]["temporal"][
+            "minimum_patch_correlation"
+        ] = 0.1
+    elif case == "old-schema":
+        config["schema"] = "monitored-walking-keyframe-camera-projection-v1"
+    elif case == "omit-ledger":
+        saved.pop("map_epochs")
+    elif case == "clock":
+        ledger["end_frame"] -= 1
+    elif case == "skip-step":
+        ledger["steps"].pop()
+    elif case == "invented-child":
+        ledger["children"] = [{"terminal": "validated", "motion": {"supported": True}}]
+    elif case == "invented-parent":
+        ledger["parent_acquisition_sha256"] = "0" * 64
+    elif case == "invented-link":
+        ledger["links"] = [{"connection_supported": True}]
+    elif case in ("restored", "gauge", "metric", "navigation"):
+        field = {
+            "restored": "old_map_restored",
+            "gauge": "global_gauge_aligned",
+            "metric": "metric_scale_known",
+            "navigation": "navigation_accepted",
+        }[case]
+        ledger[field] = True
+    elif case == "failure":
+        ledger["failure"] = {"type": "ValueError", "message": "actual failure"}
+    elif case == "missing-check":
+        report["checks"].pop("map_epoch_policy_completed")
+    else:
+        ledger["private_pose"] = [1, 2, 3]
+    save(route / "config.json", config)
+    save(route / "keyframe-acquisition.json", saved)
+    report["config_sha256"] = auditor.runtime.digest(route / "config.json")
+    report["artifact_sha256"]["keyframe-acquisition.json"] = auditor.runtime.digest(
+        route / "keyframe-acquisition.json"
+    )
+    save(route / "report.json", report)
+    private_guard(monkeypatch)
+    result = auditor.audit(route, engine)
+    assert not result["valid"] and result["evaluation"] is None
+    assert result.get("map_epoch_evaluation") is None
+    assert result["stability_diagnostics"] is None and not result["navigation_accepted"]
+
+
+@pytest.mark.parametrize(
+    "flags",
+    [
+        ["--reacquire-keyframes"],
+        [
+            "--reacquire-keyframes",
+            "--walking-keyframes",
+            "--oriented-keyframes",
+            "--long-wait-keyframes",
+            "--jump-keyframes",
+            "--safe-seed-keyframes",
+            "--recovering-keyframes",
+            "--responsive-keyframes",
+            "--micro-keyframes",
+            "--stable-keyframes",
+        ],
