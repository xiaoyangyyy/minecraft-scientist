+@pytest.mark.parametrize("selected,anchor", [(15, 51), (33, 69), (45, 81), (48, 48)])
+def test_orientation_hands_actual_endpoint_and_clock_to_unchanged_acquisition(
+    monkeypatch, selected, anchor
+):
+    first = texture(448)
+    references = [first.copy() for _ in range(12)]
+    returned = first.copy()
+    returned[100, 100] = 0
+    monkeypatch.setattr(
+        orientation, "rank_views", lambda *args: {"selected_frame": selected}
+    )
+    calls = []
+
+    def execute(kind):
+        calls.append(kind)
+        return orientation.SurveyReceipt(returned.copy(), kind, kind == "look", True, 1)
+
+    def acquire(frame, controller, camera, **kwargs):
+        assert kwargs["anchor_frame"] == anchor
+        assert all(
+            kwargs[name] is True
+            for name in (
+                "micro_controls",
+                "responsive_controls",
+                "recovery_controls",
+                "safe_seed_controls",
+                "jump_controls",
+                "long_wait_controls",
+                "oriented_controls",
+            )
+        )
+        assert controller is forbidden
+        assert np.array_equal(frame, returned if anchor != 48 else first)
+        assert kwargs["policy"] == stable.StableOrientedJumpKeyframePolicy()
+        return {"test_only": True, "anchor_frame": anchor}
+
+    monkeypatch.setattr(stable, "acquire_stable_keyframe_map", acquire)
+    result = orientation.run_oriented_keyframe_map(
+        references, execute, forbidden, np.eye(3)
+    )
+    assert len(calls) == anchor - 48
+    assert result["acquisition"]["anchor_frame"] == anchor
+    assert all(np.array_equal(image, first) for image in references)
+
