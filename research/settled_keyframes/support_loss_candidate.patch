@@ -0,0 +1,266 @@
+from itertools import groupby
+
+import numpy as np
+import pytest
+from pydantic import ValidationError
+
+pytest.importorskip("cv2", reason="optional public-support map geometry")
+
+from test_joint_multiview_map import CAMERA
+from test_safe_seed_keyframes import (
+    seeded_scene as seeded_scene,  # noqa: PLC0414 -- fixture re-export
+)
+from test_stable_keyframe_map import (
+    public_scene as public_scene,  # noqa: PLC0414 -- fixture dependency
+)
+
+from minecraft_scientist.exploration import stable_keyframe_map as stable
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+
+
+def acquire(first, execute, *, support_loss=True):
+    return stable.acquire_stable_keyframe_map(
+        first,
+        execute,
+        CAMERA,
+        anchor_frame=48,
+        seed=13,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        support_loss_controls=support_loss,
+    )
+
+
+def lose(measured):
+    return measured | {
+        "tracks": {"track_ids": [], "seed_count": measured["tracks"]["seed_count"]},
+        "cells": 0,
+    }
+
+
+@pytest.mark.parametrize("support_loss", [False, True])
+def test_completed_public_loss_without_extra_wait_has_distinct_epoch_semantics(
+    seeded_scene, monkeypatch, support_loss
+):
+    # Mock perception tests chronology; real synthetic 3-D fitting tests geometry.
+    first, execute, calls, _, _, tracked_inputs = seeded_scene
+    flow = stable._visible_flow
+
+    def one_lost_pair(first, last, *args, **kwargs):
+        measured = flow(first, last, *args, **kwargs)
+        return (
+            lose(measured)
+            if (int(first[0, 0, 0]), int(last[0, 0, 0])) == (8, 17)
+            else measured
+        )
+
+    monkeypatch.setattr(stable, "_visible_flow", one_lost_pair)
+    result = acquire(first, execute, support_loss=support_loss)
+    assert result["terminal"] == "validated"
+    assert not result["failed_wait_windows"] and not result["recovery_wait_windows"]
+    assert not result["samples"][1]["selected"]
+    assert result["samples"][1]["correspondence_supported"] is False
+    assert not result["navigation_accepted"] and not result["metric_scale_known"]
+    assert stable._digest(result["frozen"]) == result["frozen_sha256"]
+    if not support_loss:
+        assert len(result["epochs"]) == 1 and not result["epoch_links"]
+        assert "epoch_boundary_registration" not in result
+        return
+    assert result["epoch_boundary_registration"] == (
+        "public-support-loss-after-stable-control-v1"
+    )
+    parent, child = result["epochs"]
+    assert parent["status"] == "connection_lost_after_stable_control"
+    assert parent["frame_ordinals"] == [56] and parent["trial_ids"] == [0]
+    assert parent["termination_frame"] == child["anchor_frame"] == 65
+    assert child["frame_ordinals"] == [65, 74, 83, 92, 101, 110]
+    assert child["trial_ids"] == list(range(1, 6))
+    assert child["detector"]["seed_image_frame"] == 65
+    assert (
+        child["detector"]["seed_image_sha256"]
+        != parent["detector"]["seed_image_sha256"]
+    )
+    assert not child["global_gauge_aligned"]
+    link = result["epoch_links"][0]
+    assert link["parent_sha256"] == stable._digest(parent)
+    assert link["reason"] == "public_support_lost_after_stable_control"
+    assert not link["supported"] and not link["metric_scale_known"]
+    assert result["frozen"]["detector"] == child["detector"]
+    assert result["frozen"]["index"]["namespace"] == child["namespace"]
+    assert all(entry[1] is tracked_inputs[0][1] for entry in tracked_inputs)
+    choices = result["control_choices"]
+    assert choices[1]["observed_trials"] == 0 and choices[1]["scoring_trial_ids"] == []
+    assert choices[-1]["scoring_trial_ids"] == [1, 2, 3, 4]
+    assert (
+        max(len(list(run)) for _, run in groupby(item["handle"] for item in choices))
+        <= 4
+    )
+    assert len(calls) + 48 < 288
+
+
+def test_repeated_losses_cannot_create_a_third_epoch_or_extend_local_budget(
+    seeded_scene, monkeypatch
+):
+    first, execute, calls, _, _, _ = seeded_scene
+    flow = stable._visible_flow
+
+    def lost(first, last, *args, **kwargs):
+        measured = flow(first, last, *args, **kwargs)
+        return (
+            lose(measured) if int(last[0, 0, 0]) - int(first[0, 0, 0]) > 1 else measured
+        )
+
+    monkeypatch.setattr(stable, "_visible_flow", lost)
+    result = acquire(first, execute)
+    assert result["terminal"] == "map_unavailable"
+    assert len(result["epochs"]) == 2 and len(result["epoch_links"]) == 1
+    assert result["epochs"][0]["trial_ids"] == [0]
+    assert result["epochs"][1]["trial_ids"] == list(range(1, 12))
+    assert len(result["control_choices"]) == 12 and len(calls) == 116
+    assert result["epochs"][1]["frame_ordinals"] == [65]
+    assert not result["attempts"] and result["frozen"] is None
+    assert not result["recovery_wait_windows"]
+
+
+def test_supported_stalls_do_not_consume_an_epoch(seeded_scene, monkeypatch):
+    first, execute, _, _, _, _ = seeded_scene
+    flow = stable._visible_flow
+
+    def stalled(*args, **kwargs):
+        return flow(*args, **kwargs) | {"median_flow_pixels": 0}
+
+    monkeypatch.setattr(stable, "_visible_flow", stalled)
+    result = acquire(first, execute)
+    assert result["terminal"] == "map_unavailable"
+    assert len(result["epochs"]) == 1 and not result["epoch_links"]
+    assert len(result["control_choices"]) == 11
+    assert not result["attempts"] and result["frozen"] is None
+
+
+def test_noncompliant_completed_move_cannot_create_a_new_map_epoch(seeded_scene):
+    first, execute, _, _, _, _ = seeded_scene
+
+    def invalid(kind, handle):
+        receipt = execute(kind, handle)
+        return (
+            PublicControlStep(receipt.frame, kind, handle, False, 1)
+            if kind == "move"
+            else receipt
+        )
+
+    result = acquire(first, invalid)
+    assert result["terminal"] == "execution_failed"
+    assert len(result["epochs"]) == 1 and not result["epoch_links"]
+    assert len(result["samples"]) == 1
+    assert result["steps"][-1]["compliant"] is False
+
