+def test_longer_two_epoch_episode_stops_inside_actual_partial_wait_at_288(
+    seeded_scene, monkeypatch
+):
+    first, execute, calls, _, _, _ = seeded_scene
+    flow = stable._visible_flow
+
+    def slow(first, last, *args, **kwargs):
+        a, b = int(first[0, 0, 0]), int(last[0, 0, 0])
+        measured = flow(first, last, *args, **kwargs)
+        if b - a == 1 and b >= 10:
+            return measured | {"stable": (b - 9) % 25 >= 22}
+        if (a, b) == (8, 33):
+            return lose(measured)
+        return measured | {"median_flow_pixels": 0} if b - a > 1 else measured
+
+    monkeypatch.setattr(stable, "_visible_flow", slow)
+    result = acquire(first, execute)
+    assert result["terminal"] == "budget_exhausted" and len(calls) + 48 == 288
+    assert len(result["epochs"]) == 2 and len(result["epoch_links"]) == 1
+    assert result["epochs"][1]["termination_frame"] == 288
+    assert not result["recovery_wait_windows"]
+    assert result["frozen"] is None and not result["navigation_accepted"]
+
