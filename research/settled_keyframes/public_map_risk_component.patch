+"""Guard/dispatch fixtures are not proof of native geometry or navigation."""
+
+import copy
+import hashlib
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+from pydantic import ValidationError
+
+cv2 = pytest.importorskip("cv2")
+
+from minecraft_scientist.exploration import public_map_risk as risk
+from minecraft_scientist.exploration.joint_multiview_map import JointMapConfig
+from minecraft_scientist.exploration.safe_track_seeds import safe_seeds
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+from minecraft_scientist.exploration.temporal_tracks import (
+    TemporalTrackConfig,
+    TemporalTracks,
+    track_frame_chain,
+)
+
+
+@pytest.fixture
+def fixture(monkeypatch):
+    # Real public-pixel tracking, but the model parser/validator are explicit
+    # dispatch doubles: these fixtures cannot establish actual map correctness.
+    gray = cv2.GaussianBlur(
+        np.random.default_rng(42).integers(0, 256, (224, 224), dtype=np.uint8),
+        (5, 5),
+        0.8,
+    )
+    rgb = np.repeat(gray[:, :, None], 3, axis=2)
+    frames = [rgb.copy() for _ in range(6)]
+    seeds = safe_seeds(frames[0])
+    tracks = track_frame_chain(
+        frames, config=TemporalTrackConfig(maximum_frames=128), seed_pixels=seeds
+    )
+    ordinal = [56, 65, 74, 83, 92, 101]
+    frozen = {
+        "index": {
+            "namespace": "unit-dispatch-only",
+            "frame_ordinals": ordinal,
+            "rgb_sha256": [risk._rgb_hash(frame) for frame in frames],
+            "tracks": tracks.model_dump(mode="json"),
+            "continuous_raw_identity": False,
+        },
+        "past": tracks.model_dump(mode="json"),
+        "frozen_at_frame": 101,
+        "detector": {
+            "registration": "first-image-only-safe-support-mask-v1",
+            "seed_image_frame": 56,
+            "seed_image_sha256": risk._rgb_hash(frames[0]),
+            "seed_pixels": seeds.tolist(),
+        },
+        "maps": [
+            {
+                "bootstrap_slot": slot,
+                "supported": slot != 2,
+                "input_sha256": hashlib.sha256(
+                    tracks.model_dump_json().encode()
+                ).hexdigest(),
+                "fitting_frames": 6,
+                "config": JointMapConfig(),
+            }
+            for slot in (2, 3, 4, 5)
+        ],
+        "required_bootstraps": [3, 4, 5],
+    }
+    # _digest requires JSON values; parser double reconstitutes the config.
+    for model in frozen["maps"]:
+        model["config"] = model["config"].model_dump(mode="json")
+    monkeypatch.setattr(
+        risk.JointMapEvidence,
+        "model_validate",
+        lambda item: SimpleNamespace(
+            **(item | {"config": JointMapConfig.model_validate(item["config"])})
+        ),
+    )
+    calls = []
+
+    def validate(model, past, extended, *, target_slots):
+        calls.append((model.bootstrap_slot, extended.frame_count, target_slots))
+        return {
+            "status": "consistent" if model.supported else "unavailable",
+            "navigation_accepted": False,
+        }
+
+    monkeypatch.setattr(risk, "validate_joint_future", validate)
+    return frozen, frames, calls
+
+
+def receipt(frame, kind="wait", handle=None, **changes):
+    return PublicControlStep(
+        **(
+            {
+                "frame": frame,
+                "executed_kind": kind,
+                "executed_handle": handle,
+                "compliant": True,
+                "ticks": 1,
+            }
+            | changes
+        )
+    )
+
+
+def test_all_moves_and_waits_check_every_frozen_model(fixture):
+    frozen, frames, calls = fixture
+    before = copy.deepcopy(frozen)
+    monitor = risk.FrozenMapMonitor(frozen, frames)
+    first = monitor.observe(
+        receipt(frames[-1], "move", 0), kind="move", handle=0, absolute_frame=102
+    )
+    second = monitor.observe(
+        receipt(frames[-1]), kind="wait", handle=None, absolute_frame=103
+    )
+    assert first["status"] == second["status"] == "observable"
+    assert [call[0] for call in calls] == [2, 3, 4, 5] * 2
+    assert [call[2] for call in calls] == [(6,)] * 4 + [(7,)] * 4
+    assert frozen == before
+    assert first["motion_validated"] is False
+    assert monitor.journal["navigation_accepted"] is False
+    first["candidates"].clear()
+    assert len(monitor.journal["records"][0]["candidates"]) == 4
+
+
+@pytest.mark.parametrize(
+    "status,state,counterexample",
+    [("inconsistent", "challenged", True), ("unavailable", "support_lost", False)],
+)
+def test_failure_is_latched_without_selecting_a_better_model(
+    fixture, monkeypatch, status, state, counterexample
+):
+    frozen, frames, _ = fixture
+    monitor = risk.FrozenMapMonitor(frozen, frames)
+    monkeypatch.setattr(
+        risk,
+        "validate_joint_future",
+        lambda model, *args, **kwargs: {
+            "status": status if model.bootstrap_slot == 4 else "consistent"
+        },
+    )
+    record = monitor.observe(
+        receipt(frames[-1]), kind="wait", handle=None, absolute_frame=102
+    )
+    assert monitor.state == record["status"] == state
+    assert record["theory_counterexample"] is counterexample
+    assert len(record["candidates"]) == 4
+    assert record["latent_cause"] == "unidentified"
+    assert monitor.preflight("move", 1) is False
+    with pytest.raises(ValueError, match="closed/risky"):
+        monitor.observe(
+            receipt(frames[-1]), kind="wait", handle=None, absolute_frame=103
+        )
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"compliant": False},
+        {"ticks": True},
+        {"ticks": 2},
+        {"executed_handle": True},
+        {"executed_kind": "wait"},
+    ],
+)
+def test_failed_controls_cannot_enter_geometric_or_theory_evidence(fixture, change):
+    frozen, frames, calls = fixture
+    monitor = risk.FrozenMapMonitor(frozen, frames)
+    record = monitor.observe(
+        receipt(frames[-1], "move", 0, **change),
+        kind="move",
+        handle=0,
+        absolute_frame=102,
+    )
+    assert calls == []
+    assert record["status"] == "control_failed"
+    assert record["theory_counterexample"] is False
+    assert record["compliant"] is False
+    assert record["candidates"] == []
+    with pytest.raises(ValueError):
+        monitor.recover_observation(lambda *args: receipt(frames[-1]))
+
+
+def test_solver_failure_is_not_a_scientific_counterexample(fixture, monkeypatch):
+    frozen, frames, _ = fixture
