+def test_original_identity_cannot_reappear_after_it_was_lost(fixture, monkeypatch):
+    frozen, frames, _ = fixture
+    monitor = risk.FrozenMapMonitor(frozen, frames)
+    base = monitor._past
+    dead = base.track_ids[0]
+    count = 0
+
+    def tracked(images, **kwargs):
+        nonlocal count
+        count += 1
+        values = base.model_dump() | {
+            "frame_count": len(images),
+            "surviving_counts": base.surviving_counts
+            + (len(base.track_ids),) * (len(images) - base.frame_count),
+            "pixels": base.pixels
+            + (base.pixels[-1],) * (len(images) - base.frame_count),
+        }
+        extended = TemporalTracks.model_validate(values)
+        return (
+            risk.retain_tracks(extended, set(base.track_ids) - {dead})
+            if count == 1
+            else extended
+        )
+
+    # Real TemporalTracks schema, fabricated tracking output for identity logic.
+    monkeypatch.setattr(risk, "track_frame_chain", tracked)
+    first = monitor.observe(
+        receipt(frames[-1]), kind="wait", handle=None, absolute_frame=102
+    )
+    second = monitor.observe(
+        receipt(frames[-1]), kind="wait", handle=None, absolute_frame=103
+    )
+    assert dead not in first["retained_past_ids"]
+    assert dead not in second["retained_past_ids"]
