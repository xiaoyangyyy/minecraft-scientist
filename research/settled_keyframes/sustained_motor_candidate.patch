@@ -0,0 +1,229 @@
+import numpy as np
+import pytest
+from pydantic import ValidationError
+
+pytest.importorskip("cv2", reason="optional public keyframe geometry")
+
+from test_joint_multiview_map import CAMERA
+from test_long_wait_keyframes import textured
+from test_stable_keyframe_map import public_scene as public_scene  # noqa: PLC0414
+
+from minecraft_scientist.exploration import stable_keyframe_map as stable
+from minecraft_scientist.exploration.settled_map_control import PublicControlStep
+
+
+def acquire(first, execute, **kwargs):
+    return stable.acquire_stable_keyframe_map(
+        first,
+        execute,
+        ((100, 0, 112), (0, 100, 112), (0, 0, 1)),
+        anchor_frame=48,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        sustained_controls=True,
+        **kwargs,
+    )
+
+
+def test_real_static_pixels_record_eight_receipts_per_trial_not_invented_motion():
+    first, calls = textured(), []
+
+    def execute(kind, handle):
+        calls.append((kind, handle))
+        return PublicControlStep(first.copy(), kind, handle, True, 1)
+
+    result = acquire(first, execute)
+    assert result["terminal"] == "map_unavailable"
+    assert (
+        result["motor_duration_registration"] == "eight-tick-acquisition-and-future-v1"
+    )
+    assert (
+        result["micro_control_registration"]
+        == "eight-tick-acquisition-eight-tick-future-v1"
+    )
+    assert result["frozen"] is None and result["future"] is None
+    assert not result["navigation_accepted"]
+    assert len(result["samples"]) == 12 and len(calls) == 184
+    assert calls[:8] == [("wait", None)] * 8
+    handles = []
+    for slot in range(11):
+        controls = calls[8 + 16 * slot : 8 + 16 * (slot + 1)]
+        handle = controls[0][1]
+        handles.append(handle)
+        assert controls[:8] == [("move", handle)] * 8
+        assert controls[8:] == [("wait", None)] * 8
+    assert set(handles) == set(range(4))
+    assert all(step["ticks"] == 1 and step["compliant"] for step in result["steps"])
+    assert not result["failed_wait_windows"] and not result["recovery_wait_windows"]
+
+
+@pytest.mark.parametrize("failure_tick", [1, 4, 8])
+def test_failed_mid_motor_receipt_cannot_become_a_completed_trial(failure_tick):
+    first, moves = textured(), 0
+
+    def execute(kind, handle):
+        nonlocal moves
+        if kind == "move":
+            moves += 1
+        return PublicControlStep(first.copy(), kind, handle, moves != failure_tick, 1)
+
+    result = acquire(first, execute)
+    assert result["terminal"] == "execution_failed"
+    assert len(result["steps"]) == 8 + failure_tick
+    assert len(result["samples"]) == 1
+    assert result["steps"][-1]["compliant"] is False
+    assert result["frozen"] is None and result["future"] is None
+
+
+@pytest.mark.parametrize(
+    "initial_waits,post_waits,partial_moves,partial_waits",
+    [
+        (8, 22, 8, 14),
+        (9, 24, 7, 0),
+    ],
+)
+def test_global_cap_keeps_partial_wait_or_motor_without_extra_dispatch(
+    monkeypatch, initial_waits, post_waits, partial_moves, partial_waits
+):
+    first, calls, moved, waits = textured(), [], False, 0
+
+    def execute(kind, handle):
+        nonlocal moved, waits
+        calls.append((kind, handle))
+        if kind == "move":
+            moved, waits = True, 0
+        else:
+            waits += 1
+        return PublicControlStep(first.copy(), kind, handle, True, 1)
+
+    original = stable._visible_flow
+
+    def flow(*args, **kwargs):
+        value = original(*args, **kwargs)
+        value["stable"] = waits >= (post_waits if moved else initial_waits) - 2
+        return value  # synthetic timing budget only, not native success
+
+    monkeypatch.setattr(stable, "_visible_flow", flow)
+    result = acquire(first, execute)
+    assert result["terminal"] == "budget_exhausted"
+    assert len(calls) + 48 == 288
+    assert len(result["samples"]) == 8
+    partial = result["steps"][result["samples"][-1]["absolute_frame"] - 48 :]
+    assert sum(step["requested_kind"] == "move" for step in partial) == partial_moves
+    assert sum(step["requested_kind"] == "wait" for step in partial) == partial_waits
+    assert not result["recovery_wait_windows"]
+    assert result["frozen"] is None
+
+
+@pytest.mark.parametrize("flag", [1, None, "true"])
+def test_sustained_flag_must_be_boolean_before_dispatch(flag):
+    def forbidden(*args):
+        raise AssertionError("invalid flag dispatched")
+
+    with pytest.raises(ValueError, match="explicit boolean"):
+        stable.acquire_stable_keyframe_map(
+            textured(), forbidden, np.eye(3), anchor_frame=48, sustained_controls=flag
+        )
+
+
+def test_sustained_requires_full_long_wait_protocol_before_dispatch():
+    def forbidden(*args):
+        raise AssertionError("incomplete registration dispatched")
+
+    with pytest.raises(ValueError, match="explicit long-wait"):
+        stable.acquire_stable_keyframe_map(
+            textured(), forbidden, np.eye(3), anchor_frame=48, sustained_controls=True
+        )
+
+
+@pytest.mark.parametrize("failed_future_tick", [None, 4])
+def test_past_is_frozen_before_eight_distinct_future_receipts(
+    public_scene, monkeypatch, failed_future_tick
+):
+    first, execute, calls = public_scene
+    flow = stable._visible_flow
+    # Mock perception, real synthetic 3-D fitting. Do not claim native pixels.
+    monkeypatch.setattr(stable, "safe_seeds", lambda first: np.full((150, 2), 100.0))
+
+    def aligned_flow(*args, **kwargs):
+        value = flow(*args)
+        value["tracks"] = {"track_ids": list(range(150)), "seed_count": 150}
+        return value
+
+    monkeypatch.setattr(stable, "_visible_flow", aligned_flow)
+    fitted_at = []
+    fitter = stable.fit_joint_map
+
+    def recording(*args, **kwargs):
+        fitted_at.append(len(calls))
+        return fitter(*args, **kwargs)
+
+    def future_execute(kind, handle):
+        step = execute(kind, handle)
+        if failed_future_tick and len(calls) == 88 + failed_future_tick:
+            return PublicControlStep(step.frame, kind, handle, False, 1)
+        return step
+
+    monkeypatch.setattr(stable, "fit_joint_map", recording)
+    result = stable.acquire_stable_keyframe_map(
+        first,
+        future_execute,
+        CAMERA,
+        anchor_frame=48,
+        seed=13,
+        micro_controls=True,
+        responsive_controls=True,
+        recovery_controls=True,
+        safe_seed_controls=True,
+        jump_controls=True,
+        long_wait_controls=True,
+        sustained_controls=True,
+    )
+    assert fitted_at == [88] * 4
+    assert result["frozen"]["index"]["frame_ordinals"] == [56, 72, 88, 104, 120, 136]
+    assert stable._digest(result["frozen"]) == result["frozen_sha256"]
+    future_handle = result["future_control_choice"]["handle"]
+    assert future_handle != calls[72][1]
+    assert result["future_control_choice"]["at_frame"] == 136
+    assert calls[88 : 88 + (failed_future_tick or 8)] == [("move", future_handle)] * (
+        failed_future_tick or 8
+    )
+    assert result["terminal"] == (
+        "execution_failed" if failed_future_tick else "validated"
+    )
+    assert len(calls) == (88 + failed_future_tick if failed_future_tick else 104)
+    if failed_future_tick:
+        assert result["future"] is None and result["motion"] is None
+    else:
+        assert result["future"]["absolute_frame"] == 152
+        assert len(result["future"]["candidates"]) == 4
+    assert not result["navigation_accepted"]
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("move_ticks", 7),
+        ("move_ticks", 8.0),
+        ("validation_move_ticks", 2),
+        ("validation_move_ticks", True),
+        ("motor_duration", "unregistered"),
+    ],
+)
+def test_sustained_policy_has_exact_duration_and_cannot_disguise_as_parent(
+    field, value
+):
+    new = stable.StableSustainedJumpKeyframePolicy()
+    with pytest.raises(ValidationError):
+        stable.StableLongWaitJumpKeyframePolicy.model_validate(new.model_dump())
+    with pytest.raises(ValidationError):
+        stable.StableSustainedJumpKeyframePolicy.model_validate(
+            new.model_dump() | {field: value}
+        )
+    old = stable.StableLongWaitJumpKeyframePolicy()
+    for name in ("stability", "fitting", "consensus", "temporal"):
+        assert getattr(new, name) == getattr(old, name)
